<?php
declare(strict_types=1);

/**
 * /public/index.php
 * Public landing page (registry-backed Featured Subjects, DB-overlay optional, never-empty).
 *
 * Fix:
 * - Ensure homepage loads the Subjects grid/card CSS (mk-grid--subjects + mk-subject-card).
 *   Many installs only load that CSS on /subjects/, so homepage looks "unstyled" for the grid.
 */

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

require_once __DIR__ . '/_init.php';

/* Optional short cache (HTML only) */
if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'GET' && function_exists('mk_public_cache_headers')) {
  try { mk_public_cache_headers(60); } catch (Throwable $e) {}
}

/* ---------------------------------------------------------
   Core helpers
--------------------------------------------------------- */
if (!function_exists('h')) {
  function h(string $v): string { return htmlspecialchars($v, ENT_QUOTES, 'UTF-8'); }
}

$u = static function (string $path): string {
  return function_exists('url_for') ? (string)url_for($path) : $path;
};

$valid_slug = static function (string $slug): bool {
  $slug = strtolower(trim($slug));
  return ($slug !== '') && (bool)preg_match('/^[a-z0-9][a-z0-9_-]{0,190}$/', $slug);
};

$initial = static function (string $name): string {
  $name = trim($name);
  if ($name === '') return 'M';
  if (function_exists('mb_substr') && function_exists('mb_strtoupper')) {
    return (string)mb_strtoupper((string)mb_substr($name, 0, 1, 'UTF-8'), 'UTF-8');
  }
  return strtoupper(substr($name, 0, 1));
};

/* ---------------------------------------------------------
   CSS helper: add extra CSS only if file exists
--------------------------------------------------------- */
$mk_public_fs = static function (): string {
  if (defined('PUBLIC_PATH') && is_string(PUBLIC_PATH) && PUBLIC_PATH !== '') {
    return rtrim((string)PUBLIC_PATH, "/\\");
  }
  // /public/index.php -> /public_html/public, so public root is __DIR__
  return rtrim(__DIR__, "/\\");
};

$mk_css_exists = static function (string $webPath) use ($mk_public_fs): bool {
  $webPath = '/' . ltrim($webPath, '/');
  $fs = $mk_public_fs() . str_replace('/', DIRECTORY_SEPARATOR, $webPath);
  return is_file($fs);
};

$mk_add_css = static function (array &$extra_css, string $webPath) use ($mk_css_exists): void {
  $webPath = '/' . ltrim($webPath, '/');
  if (!$mk_css_exists($webPath)) return;
  if (!in_array($webPath, $extra_css, true)) $extra_css[] = $webPath;
};

/* ---------------------------------------------------------
   Canonical registry loader (deterministic)
--------------------------------------------------------- */
$registryError = '';
try {
  $regFile = '';

  if (defined('APP_ROOT')) {
    $cand = rtrim((string)APP_ROOT, "/\\") . '/private/registry/subjects_register.php';
    if (is_file($cand)) $regFile = $cand;
  }
  if ($regFile === '' && defined('PRIVATE_PATH')) {
    $cand = rtrim((string)PRIVATE_PATH, "/\\") . '/registry/subjects_register.php';
    if (is_file($cand)) $regFile = $cand;
  }
  if ($regFile === '') {
    $cand = __DIR__ . '/../private/registry/subjects_register.php';
    if (is_file($cand)) $regFile = $cand;
  }

  if ($regFile !== '') {
    /** @noinspection PhpIncludeInspection */
    require_once $regFile;
  } else {
    $registryError = 'Registry file not found: private/registry/subjects_register.php';
  }
} catch (Throwable $e) {
  $registryError = 'Registry load failed: ' . $e->getMessage();
}

/**
 * LAST resort fallback MUST match your canonical 19 (never invent).
 */
$hardcoded_registry_19 = static function(): array {
  return [
    ['id'=>1,  'slug'=>'history',      'name'=>'History'],
    ['id'=>2,  'slug'=>'slavery',      'name'=>'Slavery'],
    ['id'=>3,  'slug'=>'people',       'name'=>'People'],
    ['id'=>4,  'slug'=>'persons',      'name'=>'Persons'],
    ['id'=>5,  'slug'=>'culture',      'name'=>'Culture'],
    ['id'=>6,  'slug'=>'religion',     'name'=>'Religion'],
    ['id'=>7,  'slug'=>'spirituality', 'name'=>'Spirituality'],
    ['id'=>8,  'slug'=>'tradition',    'name'=>'Tradition'],
    ['id'=>9,  'slug'=>'language1',    'name'=>'Language1'],
    ['id'=>10, 'slug'=>'language2',    'name'=>'Language2'],
    ['id'=>11, 'slug'=>'struggles',    'name'=>'Struggles'],
    ['id'=>12, 'slug'=>'biafra',       'name'=>'Biafra'],
    ['id'=>13, 'slug'=>'nigeria',      'name'=>'Nigeria'],
    ['id'=>14, 'slug'=>'resistance',   'name'=>'Resistance'],
    ['id'=>15, 'slug'=>'africa',       'name'=>'Africa'],
    ['id'=>16, 'slug'=>'uk',           'name'=>'UK'],
    ['id'=>17, 'slug'=>'europe',       'name'=>'Europe'],
    ['id'=>18, 'slug'=>'arabs',        'name'=>'Arabs'],
    ['id'=>19, 'slug'=>'about',        'name'=>'About'],
  ];
};

$registry_subjects = [];
try {
  if (function_exists('mk_subjects_registry_sorted')) {
    $tmp = mk_subjects_registry_sorted();
    if (is_array($tmp)) $registry_subjects = $tmp;
  } elseif (function_exists('subjects_sorted_registry')) {
    $tmp = subjects_sorted_registry();
    if (is_array($tmp)) $registry_subjects = $tmp;
  } elseif (function_exists('subjects_all_registry')) {
    $tmp = subjects_all_registry();
    if (is_array($tmp)) $registry_subjects = array_values($tmp);
  }
} catch (Throwable $e) {
  $registryError = ($registryError !== '' ? $registryError . ' | ' : '') . 'Registry function failed: ' . $e->getMessage();
}

if (!$registry_subjects) $registry_subjects = $hardcoded_registry_19();

/* ---------------------------------------------------------
   Page vars (BEFORE header)
--------------------------------------------------------- */
$brand = defined('MK_BRAND_NAME') ? trim((string)MK_BRAND_NAME) : 'Mkomigbo';
if ($brand === '') $brand = 'Mkomigbo';

$page_title = 'Home • ' . $brand;
$page_desc  = 'A growing knowledge library — organized into subjects and curated pages.';
$nav_active = 'home';
$active_nav = 'home';

/**
 * IMPORTANT:
 * The homepage uses subject cards/grid classes.
 * Ensure the CSS that styles mk-grid--subjects + mk-subject-card is loaded.
 */
$extra_css  = [];

/* Try common subject-grid stylesheets (only add if present) */
$mk_add_css($extra_css, '/lib/css/subjects-public.css');
$mk_add_css($extra_css, '/lib/css/subjects.css');
$mk_add_css($extra_css, '/lib/css/subjects-index.css');
$mk_add_css($extra_css, '/lib/css/subjects-cards.css');
$mk_add_css($extra_css, '/lib/css/subjects-public.min.css');
$mk_add_css($extra_css, '/lib/css/subjects.min.css');

if (function_exists('mk_view_set')) {
  try {
    mk_view_set([
      'page_title' => $page_title,
      'page_desc'  => $page_desc,
      'nav_active' => $nav_active,
      'active_nav' => $active_nav,
      'extra_css'  => $extra_css,
    ]);
  } catch (Throwable $e) {}
}

$GLOBALS['page_title'] = $page_title;
$GLOBALS['page_desc']  = $page_desc;
$GLOBALS['nav_active'] = $nav_active;
$GLOBALS['active_nav'] = $active_nav;
$GLOBALS['extra_css']  = $extra_css;

/* Header */
$header_ok = false;
if (function_exists('mk_require_shared')) {
  try { mk_require_shared('public_header.php'); $header_ok = true; } catch (Throwable $e) {}
}
if (!$header_ok) {
  header('Content-Type: text/html; charset=UTF-8');
  echo "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'>";
  echo "<title>" . h($page_title) . "</title></head><body>";
}

/* ---------------------------------------------------------
   Optional theme hooks
--------------------------------------------------------- */
$has_accent = function_exists('pf__accent_for');
$has_logo   = function_exists('pf__subject_logo_url') || function_exists('subject_logo_webpath');

/* ---------------------------------------------------------
   DB overlay (optional, never blocks rendering)
--------------------------------------------------------- */
$db_error   = '';
$db_by_slug = [];

try {
  $pdo = function_exists('db') ? db() : null;
  if ($pdo instanceof PDO) {
    $st = $pdo->query("SELECT id, slug FROM subjects WHERE slug IS NOT NULL AND slug <> ''");
    $baseRows = $st ? ($st->fetchAll(PDO::FETCH_ASSOC) ?: []) : [];

    $ids = [];
    foreach ($baseRows as $r) {
      $slug = strtolower(trim((string)($r['slug'] ?? '')));
      if (!$valid_slug($slug)) continue;
      $id = (int)($r['id'] ?? 0);
      if ($id <= 0) continue;
      $ids[] = $id;
      $db_by_slug[$slug] = ['id' => $id, 'slug' => $slug];
    }

    if ($ids) {
      $try_col = static function (PDO $pdo, array $ids, string $col): array {
        $ph = implode(',', array_fill(0, count($ids), '?'));
        $sql = "SELECT id, {$col} AS v FROM subjects WHERE id IN ({$ph})";
        $st = $pdo->prepare($sql);
        $st->execute($ids);
        return $st->fetchAll(PDO::FETCH_ASSOC) ?: [];
      };

      $nameMap = [];
      foreach (['name', 'menu_name', 'subject_name'] as $c) {
        try {
          $rows = $try_col($pdo, $ids, $c);
          foreach ($rows as $rr) {
            $id = (int)($rr['id'] ?? 0);
            $v  = trim((string)($rr['v'] ?? ''));
            if ($id > 0 && $v !== '') $nameMap[$id] = $v;
          }
          if ($nameMap) break;
        } catch (Throwable $e) {}
      }

      $descMap = [];
      foreach (['meta_description', 'short_desc', 'description', 'content'] as $c) {
        try {
          $rows = $try_col($pdo, $ids, $c);
          $any = false;
          foreach ($rows as $rr) {
            $id = (int)($rr['id'] ?? 0);
            $v  = trim((string)($rr['v'] ?? ''));
            if ($id > 0 && $v !== '') { $descMap[$id] = $v; $any = true; }
          }
          if ($any) break;
        } catch (Throwable $e) {}
      }

      $iconMap = [];
      foreach (['icon_path', 'icon', 'logo', 'logo_path'] as $c) {
        try {
          $rows = $try_col($pdo, $ids, $c);
          foreach ($rows as $rr) {
            $id = (int)($rr['id'] ?? 0);
            $v  = trim((string)($rr['v'] ?? ''));
            if ($id > 0 && $v !== '') $iconMap[$id] = $v;
          }
          if ($iconMap) break;
        } catch (Throwable $e) {}
      }

      $visibleIds = array_fill_keys($ids, true);
      try {
        $rows = $try_col($pdo, $ids, 'status');
        foreach ($rows as $rr) {
          $id = (int)($rr['id'] ?? 0);
          $v  = strtolower(trim((string)($rr['v'] ?? '')));
          if ($id > 0) $visibleIds[$id] = in_array($v, ['active','published','public'], true);
        }
      } catch (Throwable $e) {
        try {
          $rows = $try_col($pdo, $ids, 'is_public');
          foreach ($rows as $rr) {
            $id = (int)($rr['id'] ?? 0);
            $v  = $rr['v'] ?? null;
            if ($id > 0) $visibleIds[$id] = ((int)$v === 1);
          }
        } catch (Throwable $e2) {}
      }

      foreach ($db_by_slug as $slug => $row) {
        $id = (int)($row['id'] ?? 0);
        if ($id <= 0) continue;
        $db_by_slug[$slug]['name']        = $nameMap[$id] ?? '';
        $db_by_slug[$slug]['description'] = $descMap[$id] ?? '';
        $db_by_slug[$slug]['icon_path']   = $iconMap[$id] ?? '';
        $db_by_slug[$slug]['is_visible']  = $visibleIds[$id] ?? true;
      }
    }
  }
} catch (Throwable $e) {
  $db_error = $e->getMessage();
  $db_by_slug = [];
}

/* ---------------------------------------------------------
   Build featured subjects (registry order wins)
--------------------------------------------------------- */
$final = [];
foreach ($registry_subjects as $r) {
  if (!is_array($r)) continue;
  $slug = strtolower(trim((string)($r['slug'] ?? '')));
  if (!$valid_slug($slug)) continue;

  $registry_id = (int)($r['id'] ?? 0);

  $name = trim((string)($r['name'] ?? ''));
  if ($name === '') $name = $slug;

  $desc = '';
  if (isset($r['description']) && is_string($r['description'])) $desc = trim($r['description']);
  elseif (isset($r['meta_description']) && is_string($r['meta_description'])) $desc = trim($r['meta_description']);

  $icon = trim((string)($r['icon'] ?? ''));

  $row = [
    'registry_id' => $registry_id,
    'slug'        => $slug,
    'name'        => $name,
    'description' => $desc,
    'icon_path'   => $icon,
  ];

  if (isset($db_by_slug[$slug])) {
    $dbrow = $db_by_slug[$slug];
    if (array_key_exists('is_visible', $dbrow) && $dbrow['is_visible'] === false) {
      continue;
    }
    $dbName = trim((string)($dbrow['name'] ?? ''));
    if ($dbName !== '') $row['name'] = $dbName;

    $dbDesc = trim((string)($dbrow['description'] ?? ''));
    if ($dbDesc !== '') $row['description'] = $dbDesc;

    $dbIcon = trim((string)($dbrow['icon_path'] ?? ''));
    if ($dbIcon !== '') $row['icon_path'] = $dbIcon;
  }

  $final[] = $row;
}

/* Featured: first 6 */
$featured = array_slice($final ?: $hardcoded_registry_19(), 0, 6);

?>
<div class="home-page">

<?php if ($registryError !== ''): ?>
  <div class="mk-alert mk-alert--warning" style="margin:12px 0;">
    <strong>Registry:</strong> <?= h($registryError) ?>
  </div>
<?php endif; ?>

<?php if ($db_error !== ''): ?>
  <div class="mk-alert mk-alert--danger" style="margin:12px 0;">
    <strong>DB Error:</strong> <?= h($db_error) ?>
  </div>
<?php endif; ?>

<header class="mk-hero" style="margin-top:14px;">
  <div class="mk-hero__bar" aria-hidden="true"></div>
  <div class="mk-hero__inner">
    <h1 class="mk-hero__title"><?= h($brand) ?></h1>
    <p class="mk-hero__subtitle">
      A growing knowledge library — history, culture, language, people, struggles, and more —
      organized into subjects and curated pages you can browse like a handbook.
    </p>
    <div class="mk-hero__actions" style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap;">
      <a class="mk-btn mk-btn--primary" href="<?= h($u('/subjects/')) ?>">Explore Subjects</a>
      <a class="mk-btn" href="<?= h($u('/platforms/')) ?>">Browse Platforms</a>
      <a class="mk-btn" href="<?= h($u('/contributors/')) ?>">Meet Contributors</a>
      <a class="mk-btn" href="<?= h($u('/igbo-calendar/download/')) ?>">Download Igbo Calendar</a>
    </div>
  </div>
</header>

<section style="margin-top:18px;">
  <h2 class="mk-section-title">Quick links</h2>

  <div class="mk-grid" style="margin-top:12px;">
    <a class="mk-card" href="<?= h($u('/subjects/')) ?>">
      <div class="mk-card__body">
        <div class="mk-pill" aria-hidden="true">S</div>
        <h3 style="margin-top:10px;">Subjects</h3>
        <p class="mk-muted" style="margin-top:6px;">Browse all topics and dive into pages.</p>
      </div>
    </a>

    <a class="mk-card" href="<?= h($u('/platforms/')) ?>">
      <div class="mk-card__body">
        <div class="mk-pill" aria-hidden="true">P</div>
        <h3 style="margin-top:10px;">Platforms</h3>
        <p class="mk-muted" style="margin-top:6px;">Explore tools and sections like calendars, posts, and more.</p>
      </div>
    </a>

    <a class="mk-card" href="<?= h($u('/contributors/')) ?>">
      <div class="mk-card__body">
        <div class="mk-pill" aria-hidden="true">C</div>
        <h3 style="margin-top:10px;">Contributors</h3>
        <p class="mk-muted" style="margin-top:6px;">Meet authors, editors, and collaborators.</p>
      </div>
    </a>

    <a class="mk-card" href="<?= h($u('/staff/')) ?>">
      <div class="mk-card__body">
        <div class="mk-pill" aria-hidden="true">A</div>
        <h3 style="margin-top:10px;">Staff</h3>
        <p class="mk-muted" style="margin-top:6px;">Admin dashboard for managing subjects and pages.</p>
      </div>
    </a>

    <a class="mk-card" href="<?= h($u('/igbo-calendar/')) ?>">
      <div class="mk-card__body">
        <div class="mk-pill" aria-hidden="true">I</div>
        <h3 style="margin-top:10px;">Igbo Calendar</h3>
        <p class="mk-muted" style="margin-top:6px;">Use the calendar app or download exports.</p>
      </div>
    </a>
  </div>
</section>

<section style="margin-top:22px;">
  <div style="display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap;">
    <h2 class="mk-section-title" style="margin:0;">Featured subjects</h2>
    <a class="mk-link" href="<?= h($u('/subjects/')) ?>">View all →</a>
  </div>

  <div class="mk-grid mk-grid--subjects" style="margin-top:12px;">
    <?php foreach ($featured as $s): ?>
      <?php
        $slug = strtolower(trim((string)($s['slug'] ?? '')));
        if (!$valid_slug($slug)) continue;

        $sid  = (int)($s['registry_id'] ?? 0);
        $code = ($sid > 0 && function_exists('mk_subject_ui_code'))
          ? (string)mk_subject_ui_code($sid)
          : (($sid > 0) ? ('S' . str_pad((string)$sid, 2, '0', STR_PAD_LEFT)) : '');

        $name = trim((string)($s['name'] ?? ''));
        if ($name === '') $name = $slug;

        $desc = trim((string)($s['description'] ?? ''));

        $accent = $has_accent ? (string)pf__accent_for($slug) : '';
        if (trim($accent) === '') $accent = '#0d6efd';

        $icon = trim((string)($s['icon_path'] ?? ''));
        if ($icon === '' && function_exists('subject_logo_webpath')) {
          try { $icon = (string)subject_logo_webpath($slug); } catch (Throwable $e) {}
        }
        if ($icon === '' && function_exists('pf__subject_logo_url')) {
          try { $icon = (string)pf__subject_logo_url($slug); } catch (Throwable $e) {}
        }
        if ($icon === '') $icon = '/lib/images/subjects/' . $slug . '.svg';
        if ($icon === '') $icon = '/lib/images/logo/mk-logo.png';

        $icon_url = $u($icon);
        $href = $u('/subjects/' . rawurlencode($slug) . '/');

        $ini = $initial($name);
        $ini_js = json_encode($ini, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
      ?>
      <article class="mk-card mk-subject-card" style="--accent: <?= h($accent) ?>;">
        <div class="mk-card__bar" aria-hidden="true"></div>
        <a class="mk-card__link" href="<?= h($href) ?>">
          <div class="mk-card__body">
            <div class="mk-subject-card__top">
              <div class="mk-subject-card__logo" aria-hidden="true">
                <img
                  src="<?= h($icon_url) ?>"
                  alt=""
                  loading="lazy"
                  width="64"
                  height="64"
                  style="display:block;width:64px;height:64px;border-radius:14px;object-fit:cover;"
                  onerror="this.onerror=null;this.style.display='none';var p=this.parentNode;if(p){var s=document.createElement('span');s.className='mk-subject-card__initial';s.textContent=<?= $ini_js ?>;p.appendChild(s);}">
              </div>
              <div class="mk-subject-card__titlewrap">
                <h3 class="mk-subject-card__title" style="margin:0;">
                  <?= h($name) ?>
                  <?php if ($code !== ''): ?>
                    <span class="mk-pill" style="margin-left:8px; font-size:.85em; opacity:.85;"><?= h($code) ?></span>
                  <?php endif; ?>
                </h3>
                <div class="mk-subject-card__slug mk-muted"><?= h($slug) ?></div>
              </div>
            </div>

            <?php if ($desc !== ''): ?>
              <p class="mk-muted" style="margin-top:10px;"><?= h($desc) ?></p>
            <?php endif; ?>

            <div class="mk-card__meta" style="margin-top:12px;">
              <span class="mk-pill">Explore</span>
            </div>
          </div>
        </a>
      </article>
    <?php endforeach; ?>
  </div>
</section>

<section style="margin-top:22px;">
  <a class="mk-btn" href="<?= h($u('/subjects/')) ?>">Browse all subjects</a>
</section>

</div>

<?php
if (function_exists('mk_require_shared')) {
