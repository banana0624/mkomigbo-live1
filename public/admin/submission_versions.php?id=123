<?php
require '../../_init.php';
session_start();
require 'auth.php';
auth_require_role('admin');

$db = mk_db();

$id = (int)$_GET['id'];

$stmt = $db->prepare("
    SELECT * FROM submission_versions
    WHERE submission_id = ?
    ORDER BY created_at DESC
");
$stmt->execute([$id]);

$rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
?>

<h2>Version History</h2>

<?php foreach ($rows as $r): ?>
    <pre><?= htmlspecialchars($r['snapshot']) ?></pre>
    <hr>
<?php endforeach; ?>