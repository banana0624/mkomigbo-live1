# /home/mkomigbo/public_html/public/.htaccess
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On

# Let /public/lib/* pass through (assets live here)
RewriteRule ^lib/ - [L]

# Serve existing files/dirs
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Default fallback for /public/ only
RewriteRule ^ index.php [L,QSA]
</IfModule>
