<?php

ini_set('display_errors', 1);
error_reporting(E_ALL);

// MINIMAL BOOTSTRAP ONLY

try {
    $pdo = new PDO(
        "mysql:host=localhost;dbname=YOUR_DB;charset=utf8mb4",
        "YOUR_USER",
        "YOUR_PASS",
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
    );
} catch (Exception $e) {
    die($e->getMessage());
}