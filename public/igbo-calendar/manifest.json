{
  "name": "Igbo Calendar",
  "short_name": "Igbo Calendar",
  "description": "Igbo Calendar PWA with offline support.",

  "id": "/igbo-calendar/",
  "start_url": "/igbo-calendar/?pwa=1",
  "scope": "/igbo-calendar/",

  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],

  "background_color": "#ffffff",
  "theme_color": "#ffffff",

  "lang": "en",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,

  "icons": [
    {
      "src": "/igbo-calendar/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/igbo-calendar/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/igbo-calendar/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/igbo-calendar/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "screenshots": [
    {
      "src": "/igbo-calendar/screenshots/screen-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/igbo-calendar/screenshots/screen-mobile.png",
      "sizes": "720x1280",
      "type": "image/png"
    }
  ]
}
