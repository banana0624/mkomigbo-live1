                <div class="igcal-controls__row">
                  <button class="igcal-btn" type="button" id="igcal-prev-month">◀ Prev</button>
                  <button class="igcal-btn igcal-btn--primary" type="button" id="igcal-current-month">Today</button>
                  <button class="igcal-btn" type="button" id="igcal-next-month">Next ▶</button>
                  <button class="igcal-btn" type="button" id="igcal-toggle-4weeks" aria-pressed="false">Toggle 4 Weeks</button>
