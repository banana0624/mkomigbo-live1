<script>
(function(){
  // Auto-submit when selects change
  var f = document.querySelector('.igcal-controls');
  if (f) {
    var y = document.getElementById('igcal-year');
    var m = document.getElementById('igcal-month');
    function go(){ try{ f.submit(); }catch(e){} }
    if (y) y.addEventListener('change', go);
    if (m) m.addEventListener('change', go);
  }

  // Focus/scroll to date cell if present (renderer prints data-iso="YYYY-MM-DD")
  var params = new URLSearchParams(window.location.search);
  var iso = params.get('focus');
  if (iso) {
    var cell = document.querySelector('[data-iso="' + CSS.escape(iso) + '"]');
    if (cell) {
      try { cell.scrollIntoView({behavior:'smooth', block:'center'}); } catch(e) { cell.scrollIntoView(true); }
      cell.classList.add('mk-cal-cell--focus');
      setTimeout(function(){ cell.classList.remove('mk-cal-cell--focus'); }, 2200);
    }
  }
})();
</script>

