$baseUrl = $u('/igbo-calendar/');
if (isset($_GET['find_date']) || isset($_GET['find_year']) || isset($_GET['find_month']) || isset($_GET['find_day'])) {
  $iso = (string)($_GET['find_date'] ?? '');

  if ($iso === '') {
    $fy = trim((string)($_GET['find_year'] ?? ''));
    $fm = trim((string)($_GET['find_month'] ?? ''));
    $fd = trim((string)($_GET['find_day'] ?? ''));
    if (preg_match('/^-?\d+$/', $fy) && preg_match('/^\d{1,2}$/', $fm) && preg_match('/^\d{1,2}$/', $fd)) {
      $y = (int)$fy; $m = (int)$fm; $d = (int)$fd;
      if ($m >= 1 && $m <= 12 && $d >= 1 && $d <= 31) {
        $iso = sprintf('%d-%02d-%02d', $y, $m, $d);
      }
    }
  }

  $mapped = $iso !== '' ? $map_greg_iso_to_igbo($iso) : null;
  if ($mapped) {
    $dest = $baseUrl
      . '?ys=' . rawurlencode((string)$mapped['year_start_iso'])
      . '&m=' . (int)$mapped['igbo_month']
      . '&focus=' . rawurlencode($iso);
    header('Location: ' . $dest, true, 302);
    exit;
  } else {
    // fall through; sidebar will show an inline error
    $qsFocusIso = $iso;
    $GLOBALS['igcal_find_error'] = 'Invalid date. Use YYYY-MM-DD (e.g., 1945-06-01).';
  }
}

