<?php
declare(strict_types=1);

/**
 * One-time OPcache reset helper (DELETE AFTER USE).
 * Usage:
 *   https://mkomigbo.com/igbo-calendar/_opcache_reset.php?k=CHANGE_ME
 */

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

$key = (string)($_GET['k'] ?? '');
$expected = 'CHANGE_ME'; // <-- set a hard random string before upload

header('Content-Type: text/plain; charset=utf-8');

if ($expected === 'CHANGE_ME') {
  echo "Set \$expected to a random key, then reload.\n";
  exit;
}
if (!hash_equals($expected, $key)) {
  http_response_code(403);
  echo "Forbidden\n";
  exit;
}

$ok = false;
if (function_exists('opcache_reset')) {
  $ok = @opcache_reset();
}

echo "opcache_reset: " . ($ok ? "OK" : "FAILED/UNAVAILABLE") . "\n";
echo "now: " . gmdate('c') . "\n";
