<?php
declare(strict_types=1);

/**
 * /public/subjects/pages/nigeria/intro.php
 * Content partial (NO header/footer).
 *
 * Compatible with /public/subjects/page.php fallback loader:
 * - Can be included (echo captured)
 * - Can return ['title' => ..., 'body_html' => ...]
 *
 * Variables expected (from page.php):
 * - $subject_slug (string)
 * - $page_slug (string)
 * - $subject_title (string)
 * - $page_title_txt (string)
 * - $u (callable) optional
 */

if (!function_exists('h')) {
  function h(string $v): string { return htmlspecialchars($v, ENT_QUOTES, 'UTF-8'); }
}

$u = (isset($u) && is_callable($u))
  ? $u
  : static function(string $path): string {
      return function_exists('url_for') ? (string)url_for($path) : $path;
    };

$subject_slug   = isset($subject_slug) ? (string)$subject_slug : 'africa';
$page_slug      = isset($page_slug) ? (string)$page_slug : 'intro';
$subject_title  = isset($subject_title) && trim((string)$subject_title) !== ''
  ? (string)$subject_title
  : ucwords(str_replace(['-','_'], ' ', $subject_slug));

$page_title_txt = isset($page_title_txt) && trim((string)$page_title_txt) !== ''
  ? (string)$page_title_txt
  : 'Introduction';

$next = [
  ['label' => 'Overview',   'slug' => 'overview'],
  ['label' => 'Key Topics', 'slug' => 'topics'],
  ['label' => 'People',     'slug' => 'people'],
  ['label' => 'Sources',    'slug' => 'sources'],
];

ob_start();
?>
<div class="mk-prose">

  <p class="mk-muted" style="margin-top:0;">
    This is the <strong><?= h($page_title_txt) ?></strong> page for <strong><?= h($subject_title) ?></strong>.
    It’s a premium starter scaffold — readable now and expandable later.
  </p>

  <h2>What this subject covers</h2>
  <ul>
    <li><strong>Core ideas</strong> — definitions, scope, and key distinctions.</li>
    <li><strong>Key context</strong> — background readers need to understand the topic.</li>
    <li><strong>Evidence</strong> — sources, links, archives, media.</li>
    <li><strong>Debates</strong> — competing viewpoints with citations.</li>
  </ul>

  <h2>Explore next</h2>
  <div style="display:flex; gap:10px; flex-wrap:wrap; margin:10px 0 4px;">
    <?php foreach ($next as $n): ?>
      <a class="mk-btn mk-btn--ghost"
         href="<?= h($u('/subjects/' . rawurlencode($subject_slug) . '/' . rawurlencode($n['slug']) . '/')) ?>">
        <?= h($n['label']) ?>
      </a>
    <?php endforeach; ?>
  </div>

  <h2>Contribute</h2>
  <p>
    Add a clean lede, build sections, and attach trusted references using <code>links.json</code> and local files.
  </p>

</div>
<?php
$body = (string)ob_get_clean();

return [
  'title' => $page_title_txt,
  'body_html' => $body,
];
