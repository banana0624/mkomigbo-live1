<?php
declare(strict_types=1);

/**
 * /public/attachments/file.php
 * Serve a page_files row by id:
 *   /attachments/file.php?id=123
 *
 * - External rows redirect to external_url
 * - Local rows serve files from: /lib/uploads/page_files/...
 */

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

require_once __DIR__ . '/../_init.php';

function mk_fail(int $code, string $msg): void {
  http_response_code($code);
  header('Content-Type: text/plain; charset=UTF-8');
  echo $msg;
  exit;
}

$id = isset($_GET['id']) ? (int)$_GET['id'] : 0;
if ($id <= 0) mk_fail(400, 'Bad Request');

if (!function_exists('db')) mk_fail(500, 'DB not available');
$pdo = db();
if (!($pdo instanceof PDO)) mk_fail(500, 'DB not available');

$st = $pdo->prepare("
  SELECT
    id, is_external, external_url,
    stored_path, stored_name, file_path, original_name, mime_type, file_size
  FROM page_files
  WHERE id = :id
  LIMIT 1
");
$st->execute([':id' => $id]);
$r = $st->fetch(PDO::FETCH_ASSOC);
if (!$r) mk_fail(404, 'Not Found');

$is_external = (int)($r['is_external'] ?? 0) === 1;
if ($is_external) {
  $u = trim((string)($r['external_url'] ?? ''));
  if ($u === '') mk_fail(404, 'Not Found');
  header('Location: ' . $u, true, 302);
  exit;
}

/**
 * Resolve local file.
 * Priority:
 *  1) stored_path (often relative under lib/uploads/page_files/)
 *  2) file_path   (legacy)
 *  3) stored_name (fallback: search under lib/uploads/page_files)
 */
$base = realpath(__DIR__ . '/../../lib/uploads/page_files');
if (!$base) mk_fail(500, 'Storage not configured');

$candidates = [];
$sp = trim((string)($r['stored_path'] ?? ''));
$fp = trim((string)($r['file_path'] ?? ''));
$sn = trim((string)($r['stored_name'] ?? ''));

if ($sp !== '') $candidates[] = $sp;
if ($fp !== '') $candidates[] = $fp;

$found = '';
foreach ($candidates as $rel) {
  $rel = str_replace('\\', '/', $rel);
  $rel = ltrim($rel, '/');

  // strip known prefixes if they were stored with them
  $rel = preg_replace('#^(?:lib/uploads/|uploads/)?page_files/#', '', $rel);

  if (strpos($rel, '..') !== false) continue;

  $full = $base . '/' . $rel;
  $real = realpath($full);
  if ($real && is_file($real) && str_starts_with($real, $base . DIRECTORY_SEPARATOR)) {
    $found = $real;
    break;
  }
}

if ($found === '' && $sn !== '') {
  // last resort: find by stored_name anywhere under page_files
  $sn = basename($sn);
  if ($sn !== '' && strpos($sn, '..') === false) {
    $it = new RecursiveIteratorIterator(
      new RecursiveDirectoryIterator($base, FilesystemIterator::SKIP_DOTS)
    );
    foreach ($it as $f) {
      if ($f->isFile() && $f->getFilename() === $sn) {
        $found = $f->getPathname();
        break;
      }
    }
  }
}

if ($found === '') mk_fail(404, 'File missing');

$mime = trim((string)($r['mime_type'] ?? ''));
if ($mime === '') $mime = 'application/octet-stream';

$dl_name = trim((string)($r['original_name'] ?? ''));
if ($dl_name === '') $dl_name = basename($found);
$dl_name = str_replace(["\r","\n"], '', $dl_name);

$size = @filesize($found);
if ($size === false) $size = null;

header('X-Content-Type-Options: nosniff');
header('Content-Type: ' . $mime);
header('Content-Disposition: inline; filename="' . addslashes($dl_name) . '"');
if ($size !== null) header('Content-Length: ' . (string)$size);

$fp = fopen($found, 'rb');
if (!$fp) mk_fail(500, 'Read failed');
fpassthru($fp);
fclose($fp);
exit;
