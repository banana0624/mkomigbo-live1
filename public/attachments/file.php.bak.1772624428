<?php
declare(strict_types=1);

/**
 * /public/attachments/file.php
 * Serve page_files row by id:
 *   /attachments/file.php?id=123
 *
 * SECURITY / PROFESSIONAL HARDENING:
 * - Access control hook (staff-only by default)
 * - Safe external redirect (http/https only)
 * - Safe filename headers (RFC 5987)
 * - No path traversal (id-based, within uploads base)
 * - Optional expensive fallback (disabled by default)
 * - Sensible caching + nosniff
 */

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

require_once __DIR__ . '/../_init.php';

function mk_fail(int $code, string $msg): void {
  http_response_code($code);
  header('Content-Type: text/plain; charset=UTF-8');
  echo $msg;
  exit;
}

function mk_is_staff_request(): bool {
  // If your staff area already sets body.staff, session flags, or helpers,
  // prefer those. This is a conservative fallback.
  if (function_exists('staff_is_logged_in')) return (bool)staff_is_logged_in();
  if (function_exists('is_staff_logged_in')) return (bool)is_staff_logged_in();

  // Common pattern: _init.php starts session and sets staff_user_id
  if (session_status() === PHP_SESSION_ACTIVE) {
    if (!empty($_SESSION['staff_user_id'])) return true;
    if (!empty($_SESSION['staff_id'])) return true;
    if (!empty($_SESSION['is_staff'])) return true;
  }
  return false;
}

function mk_require_attachment_access(array $row): void {
  // Default policy (professional safe): attachments are NOT public.
  // If you want public attachments for public pages, create a helper in _init.php:
  //   function attachments_public_allowed(array $row): bool { ... }
  // and return true for allowed cases (e.g., public pages only).
  if (function_exists('attachments_public_allowed')) {
    if ((bool)attachments_public_allowed($row) === true) return;
  }

  if (mk_is_staff_request()) return;

  // If not allowed:
  mk_fail(403, 'Forbidden');
}

function mk_safe_external_url(string $u): string {
  $u = trim($u);
  if ($u === '') return '';
  // Disallow control chars
  if (preg_match('/[\r\n\0]/', $u)) return '';
  $p = @parse_url($u);
  if (!is_array($p)) return '';
  $scheme = strtolower((string)($p['scheme'] ?? ''));
  if (!in_array($scheme, ['http', 'https'], true)) return '';
  if (empty($p['host'])) return '';
  return $u;
}

function mk_header_filename(string $name): array {
  // Remove CR/LF and trim
  $name = str_replace(["\r", "\n"], '', trim($name));
  if ($name === '') $name = 'download';

  // ASCII fallback for filename=""
  $ascii = preg_replace('/[^A-Za-z0-9._-]+/', '_', $name);
  if ($ascii === '' || $ascii === '_' ) $ascii = 'download';

  // RFC 5987 for UTF-8
  $utf8 = rawurlencode($name);

  return [$ascii, $utf8];
}

$id = isset($_GET['id']) ? (int)$_GET['id'] : 0;
if ($id <= 0) mk_fail(400, 'Bad Request');

if (!function_exists('db')) mk_fail(500, 'DB not available');
$pdo = db();
if (!($pdo instanceof PDO)) mk_fail(500, 'DB not available');

$st = $pdo->prepare("
  SELECT
    id, page_id, is_external, external_url,
    stored_path, stored_name, file_path, original_name, mime_type, file_size
  FROM page_files
  WHERE id = :id
  LIMIT 1
");
$st->execute([':id' => $id]);
$r = $st->fetch(PDO::FETCH_ASSOC);
if (!$r) mk_fail(404, 'Not Found');

/* ACCESS CONTROL (critical) */
mk_require_attachment_access($r);

$is_external = ((int)($r['is_external'] ?? 0) === 1);
if ($is_external) {
  $u = mk_safe_external_url((string)($r['external_url'] ?? ''));
  if ($u === '') mk_fail(404, 'Not Found');
  header('X-Content-Type-Options: nosniff');
  header('Referrer-Policy: strict-origin-when-cross-origin');
  header('Location: ' . $u, true, 302);
  exit;
}

$base = realpath(__DIR__ . '/../../lib/uploads/page_files');
if (!$base) mk_fail(500, 'Storage not configured');

$candidates = [];
$sp = trim((string)($r['stored_path'] ?? ''));
$fp = trim((string)($r['file_path'] ?? ''));

if ($sp !== '') $candidates[] = $sp;
if ($fp !== '') $candidates[] = $fp;

$found = '';

foreach ($candidates as $rel) {
  $rel = str_replace('\\', '/', $rel);
  $rel = ltrim($rel, '/');
  $rel = preg_replace('#^(?:lib/uploads/|uploads/)?page_files/#', '', $rel);

  if (strpos($rel, '..') !== false) continue;

  $full = $base . '/' . $rel;
  $real = realpath($full);

  if ($real && is_file($real) && str_starts_with($real, $base . DIRECTORY_SEPARATOR)) {
    $found = $real;
    break;
  }
}

/**
 * Optional expensive fallback:
 * If you REALLY need it, define in _init.php:
 *   define('MK_ATTACHMENTS_ALLOW_SCAN_FALLBACK', true);
 */
if ($found === '' && defined('MK_ATTACHMENTS_ALLOW_SCAN_FALLBACK') && MK_ATTACHMENTS_ALLOW_SCAN_FALLBACK === true) {
  $sn = trim((string)($r['stored_name'] ?? ''));
  if ($sn !== '') {
    $sn = basename($sn);
    if ($sn !== '' && strpos($sn, '..') === false) {
      $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($base, FilesystemIterator::SKIP_DOTS)
      );
      foreach ($it as $f) {
        if ($f->isFile() && $f->getFilename() === $sn) {
          $found = $f->getPathname();
          break;
        }
      }
    }
  }
}

if ($found === '') mk_fail(404, 'File missing');

$mime = trim((string)($r['mime_type'] ?? ''));
if ($mime === '') $mime = 'application/octet-stream';

$dl_name = trim((string)($r['original_name'] ?? ''));
if ($dl_name === '') $dl_name = basename($found);
[$ascii, $utf8] = mk_header_filename($dl_name);

$size = @filesize($found);
if ($size === false) $size = null;

/* Headers */
header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: strict-origin-when-cross-origin');

/**
 * Caching:
 * - staff/protected: no-store (safer)
 * - if you later allow public: you can relax this in attachments_public_allowed()
 */
header('Cache-Control: private, no-store, max-age=0');
header('Pragma: no-cache');

header('Content-Type: ' . $mime);
header('Content-Disposition: inline; filename="' . $ascii . '"; filename*=UTF-8\'\'' . $utf8);

if ($size !== null) header('Content-Length: ' . (string)$size);

/* Stream file */
$fh = fopen($found, 'rb');
if (!$fh) mk_fail(500, 'Read failed');
fpassthru($fh);
fclose($fh);
exit;