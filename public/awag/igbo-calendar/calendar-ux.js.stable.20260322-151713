      '<div class="igcal-summary-line">Moon: <strong>' + esc(d.moonStage) + '</strong> ' + esc(d.moonEmoji) + ' · ' + esc(String(d.moonPct)) + '%</div>';
  }

  function htmlViewedDayBox(d){
    return '' +
      '<div class="igcal-summary-line"><strong>' + esc(d.marketName + " " + d.marketSymbol) + '</strong></div>' +
      '<div class="igcal-summary-line">Igbo Year: <strong>' + esc(String(d.year)) + '</strong></div>' +
      '<div class="igcal-summary-line">Igbo Month: <strong>' + esc(d.monthName) + '</strong></div>' +
      '<div class="igcal-summary-line">Igbo Day: <strong>' + esc(String(d.igboDay)) + '</strong></div>' +
      '<div class="igcal-summary-line">' + esc(d.gregorianLong) + '</div>' +
      '<div class="igcal-summary-line">Moon: <strong>' + esc(d.moonStage) + '</strong> ' + esc(d.moonEmoji) + ' · ' + esc(String(d.moonPct)) + '%</div>';
  }

  function htmlViewedMonthBox(y, m, startIso, endIso){
    return '' +
      '<div class="igcal-summary-line"><strong>' + esc(monthName(m)) + '</strong></div>' +
      '<div class="igcal-summary-line">' + esc(monthDetail(m)) + '</div>' +
      '<div class="igcal-summary-line">Igbo Year: <strong>' + esc(String(y)) + '</strong></div>' +
      '<div class="igcal-summary-line">Month Days: <strong>' + esc(String(getMonthDays(y, m))) + '</strong></div>' +
      '<div class="igcal-summary-line">Gregorian Start: <strong>' + esc(startIso || "Unavailable") + '</strong></div>' +
      '<div class="igcal-summary-line">Gregorian End: <strong>' + esc(endIso || "Unavailable") + '</strong></div>';
  }

  function htmlViewedYearBox(y, m){
    return '' +
      '<div class="igcal-summary-line"><strong>Igbo Year ' + esc(String(y)) + '</strong></div>' +
      '<div class="igcal-summary-line">Viewed Month: <strong>' + esc(monthName(m)) + '</strong></div>' +
      '<div class="igcal-summary-line">Leap Year Rule: ' + (isLeapYear(y) ? 'Month 1 has 29 days.' : 'Month 1 has 28 days.') + '</div>' +
      '<div class="igcal-summary-line">Month 7 always has 29 days.</div>';
  }

  function htmlRangeBox(y, ys, ysNext){
    var endLabel = "Unavailable";
    if (ysNext) {
      var nextDt = parseYmdToUtcDate(ysNext);
      if (nextDt) {
        var endDt = new Date(nextDt.getTime() - (86400 * 1000));
        endLabel = utcDateToYmd(endDt);
      }
    }
    return '' +
      '<div class="igcal-summary-line"><strong>Igbo Year ' + esc(String(y)) + '</strong></div>' +
      '<div class="igcal-summary-line">Starts: <strong>' + esc(ys || "Unavailable") + '</strong></div>' +
      '<div class="igcal-summary-line">Ends: <strong>' + esc(endLabel) + '</strong></div>';
  }

  function buildDayDataFromCell(cell){
    if (!cell) return null;

    var iso = String(cell.getAttribute("data-iso") || "");
    var igboDay = parseInt(cell.getAttribute("data-igbo-day") || "0", 10);
    var month = parseInt(cell.getAttribute("data-month") || "0", 10);
    var year = parseInt(cell.getAttribute("data-year") || "0", 10);

    if (!iso || !igboDay || !month || !year) return null;

    var marketName = String(cell.getAttribute("data-market") || "");
    if (!marketName) {
      marketName = MARKET_NAMES[marketIdxForIso(iso)] || "";
    }

    var marketSymbol = String(cell.getAttribute("data-market-symbol") || "");
    if (!marketSymbol) {
      marketSymbol = MARKET_SYMBOLS[marketName] || "";
    }

    var gregorianLong = String(cell.getAttribute("data-weekday-long") || "");
    if (!gregorianLong) {
      gregorianLong = formatUtcLongDate(iso);
    }

    var moonStage = String(cell.getAttribute("data-moon-stage") || "");
    var moonPct = parseInt(cell.getAttribute("data-moon-pct") || "0", 10);
    var moonEmoji = String(cell.getAttribute("data-moon-emoji") || "");

    if (!moonStage || !moonEmoji || isNaN(moonPct)) {
      var moon = moonInfoForIso(iso);
      moonStage = moonStage || moon.stage;
      moonPct = isNaN(moonPct) ? moon.pct : moonPct;
      moonEmoji = moonEmoji || moon.emoji;
    }

    return {
      year: year,
      month: month,
      monthName: cell.getAttribute("data-month-name") || monthName(month),
      monthDetail: cell.getAttribute("data-month-detail") || monthDetail(month),
      igboDay: igboDay,
      gregorianIso: iso,
      gregorianLong: gregorianLong,
      marketName: marketName,
      marketSymbol: marketSymbol,
      moonStage: moonStage,
      moonPct: moonPct,
      moonEmoji: moonEmoji
    };
  }

  function deriveCurrentIgboData(a){
    var todayIso = a.getAttribute("data-today-iso") || "";
    if (!/^\d{4}-\d{2}-\d{2}$/.test(todayIso)) {
      todayIso = utcDateToYmd(new Date());
    }

    var todayDt = parseYmdToUtcDate(todayIso);
    if (!todayDt) return Promise.resolve(null);

    var gregYear = todayDt.getUTCFullYear();

    return Promise.all([
      fetchYearStart(a, gregYear - 1),
      fetchYearStart(a, gregYear),
      fetchYearStart(a, gregYear + 1)
    ]).then(function(res){
      var ysPrev = res[0];
      var ysCurr = res[1];
      var ysNext = res[2];

      var todayMs = todayDt.getTime();
      var currStart = ysCurr ? parseYmdToUtcDate(ysCurr) : null;
      var nextStart = ysNext ? parseYmdToUtcDate(ysNext) : null;
      var prevStart = ysPrev ? parseYmdToUtcDate(ysPrev) : null;

      var igboYear = gregYear;
      var startDt = currStart;

      if (currStart && todayMs < currStart.getTime()) {
        igboYear = gregYear - 1;
        startDt = prevStart;
      } else if (currStart && nextStart && todayMs >= nextStart.getTime()) {
        igboYear = gregYear + 1;
        startDt = nextStart;
      }

      if (!startDt) return null;

      var diffDays = Math.floor((todayMs - startDt.getTime()) / (86400 * 1000));
      if (diffDays < 0) return null;

      var month = 1;
      var day = diffDays + 1;

      for (var mm = 1; mm <= 13; mm++) {
        var md = getMonthDays(igboYear, mm);
        if (day <= md) {
          month = mm;
          break;
        }
        day -= md;
      }

      var marketIdx = marketIdxForIso(todayIso);
      var marketName = MARKET_NAMES[marketIdx];
      var moon = moonInfoForIso(todayIso);

      return {
        todayIso: todayIso,
        gregorianLong: formatUtcLongDate(todayIso),
        igboYear: igboYear,
        igboMonth: month,
        igboDay: day,
        igboMonthName: monthName(month),
        marketName: marketName,
        marketSymbol: MARKET_SYMBOLS[marketName] || "",
        moonStage: moon.stage,
        moonPct: moon.pct,
        moonEmoji: moon.emoji
      };
    }).catch(function(){
      return null;
    });
  }

  function updateCurrentSummary(a){
    var box = qs("#igcal-current-summary", a);
    if (!box) return;

    box.textContent = "Loading current day…";

    deriveCurrentIgboData(a).then(function(d){
      if (!d) {
        box.textContent = "Current day details unavailable.";
        return;
      }

      box.innerHTML = htmlCurrentBox(d);

      var yEl = qs("#igcal-current-year-label", a);
      var mEl = qs("#igcal-current-month-label", a);
      var dEl = qs("#igcal-current-day-label", a);

      if (yEl) yEl.textContent = String(d.igboYear);
      if (mEl) mEl.textContent = d.igboMonthName;
      if (dEl) dEl.textContent = d.marketName + " · Igbo Day " + d.igboDay;
    }).catch(function(){
      box.textContent = "Current day details unavailable.";
    });
  }

  function clearViewedSelection(a){
    qsa(".mk-cal-cell.is-selected", a).forEach(function(cell){
      cell.classList.remove("is-selected");
      var btn = qs(".mk-cal-cell__button", cell);
      if (btn) btn.setAttribute("aria-pressed", "false");
    });
  }

  function findVisibleMonthEl(a){
    var st = getState(a);
    return qs('.igcal-month[data-ig-month="' + String(st.m) + '"]', a);
  }

  function firstSelectableCellInVisibleMonth(a){
    var monthEl = findVisibleMonthEl(a);
    if (!monthEl) return null;

    var todayIso = a.getAttribute("data-today-iso") || "";
    var todayCell = qs('.mk-cal-cell[data-iso="' + todayIso + '"]', monthEl);
    if (todayCell) return todayCell;

    return qs('.mk-cal-cell', monthEl);
  }

  function findCellByIsoInApp(a, iso){
    if (!iso) return null;
    return qs('.mk-cal-cell[data-iso="' + String(iso) + '"]', a);
  }

  function getSelectedViewedCell(a){
    return qs(".mk-cal-cell.is-selected", a) || firstSelectableCellInVisibleMonth(a);
  }

  function updateViewedDaySummary(a, cell){
    var box = qs("#igcal-viewed-day-summary", a);
    if (!box) return null;

    if (!cell) {
      cell = firstSelectableCellInVisibleMonth(a);
    }

    if (!cell) {
      clearViewedSelection(a);
      box.textContent = "Select a day from the calendar.";
      return null;
    }

    clearViewedSelection(a);
    cell.classList.add("is-selected");

    var btn = qs(".mk-cal-cell__button", cell);
    if (btn) btn.setAttribute("aria-pressed", "true");

    var d = buildDayDataFromCell(cell);
    if (!d) {
      box.textContent = "Select a day from the calendar.";
      return null;
    }

    box.innerHTML = htmlViewedDayBox(d);
    return cell;
  }

  function deriveViewedMonthRange(a){
    var st = getState(a);

    return fetchYearStart(a, st.y).then(function(ys){
      var startDt = parseYmdToUtcDate(ys || "");
      if (!startDt) {
        return { startIso: "Unavailable", endIso: "Unavailable" };
      }

      var offsetDays = 0;
      for (var mm = 1; mm < st.m; mm++) {
        offsetDays += getMonthDays(st.y, mm);
      }

      var monthStartDt = new Date(startDt.getTime() + (offsetDays * 86400 * 1000));
      var monthEndDt   = new Date(monthStartDt.getTime() + ((getMonthDays(st.y, st.m) - 1) * 86400 * 1000));

      return {
        startIso: utcDateToYmd(monthStartDt),
        endIso: utcDateToYmd(monthEndDt)
      };
    }).catch(function(){
      return { startIso: "Unavailable", endIso: "Unavailable" };
    });
  }

  function updateMonthSummary(a){
    var box = qs("#igcal-viewed-month-summary", a);
    if (!box) return;

    var st = getState(a);
    box.textContent = "Loading month…";

    deriveViewedMonthRange(a).then(function(range){
      box.innerHTML = htmlViewedMonthBox(st.y, st.m, range.startIso, range.endIso);
    }).catch(function(){
      box.innerHTML = htmlViewedMonthBox(st.y, st.m, "Unavailable", "Unavailable");
    });
  }

  function updateYearSummary(a){
    var box = qs("#igcal-viewed-year-summary", a);
    if (!box) return;
    var st = getState(a);
    box.innerHTML = htmlViewedYearBox(st.y, st.m);
  }

  function updateRangeSummary(a){
    var st = getState(a);
    var box = qs("#igcal-year-range-summary", a);
    if (!box) return;

    Promise.all([fetchYearStart(a, st.y), fetchYearStart(a, st.y + 1)]).then(function(res){
      box.innerHTML = htmlRangeBox(st.y, res[0], res[1]);
    }).catch(function(){
      box.textContent = "Year range unavailable.";
    });
  }

  function syncSelectors(a){
    var st = getState(a);

    var monthSel = qs("#igcal-month-select", a);
    if (monthSel) monthSel.value = String(st.m);

    var yearSel = qs("#igcal-year-select", a);
    if (yearSel) yearSel.value = String(st.y);
  }

  function syncVisibleMonth(a, preferredCell){
    var st = getState(a);

    showOnlyMonth(a, st.m);
    syncSelectors(a);
    updateMonthSummary(a);
    updateYearSummary(a);
    updateRangeSummary(a);

    var chosen = preferredCell || firstSelectableCellInVisibleMonth(a);
    return updateViewedDaySummary(a, chosen);
  }

  function scrollChosenIntoView(chosen){
    if (chosen && chosen.scrollIntoView) {
      try {
        chosen.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (_) {}
    }
  }

  function selectCellByIsoOrFallback(a, iso){
    var cell = findCellByIsoInApp(a, iso);
    if (!cell) {
      cell = firstSelectableCellInVisibleMonth(a);
    }
    return updateViewedDaySummary(a, cell);
  }

  function moveViewedDay(a, delta){
    var selected = getSelectedViewedCell(a);
    if (!selected) {
      syncVisibleMonth(a);
      return;
    }

    var iso = String(selected.getAttribute("data-iso") || "");
    var dt = parseYmdToUtcDate(iso);
    if (!dt) {
      syncVisibleMonth(a);
      return;
    }

    var targetDt = new Date(dt.getTime() + (delta * 86400 * 1000));
    var targetIso = utcDateToYmd(targetDt);

    var targetCell = findCellByIsoInApp(a, targetIso);
    if (!targetCell) {
      syncVisibleMonth(a);
      return;
    }

    var targetYear = clampInt(targetCell.getAttribute("data-year"), 1, 9999, getState(a).y);
    var targetMonth = clampInt(targetCell.getAttribute("data-month"), 1, 13, getState(a).m);

    setState(a, targetYear, targetMonth);
    var chosen = syncVisibleMonth(a, targetCell);
    scrollChosenIntoView(chosen);
  }

  function goToRealToday(a){
    deriveCurrentIgboData(a).then(function(currentInfo){
      if (!currentInfo) {
        syncVisibleMonth(a);
        return;
      }

      var targetYear = clampInt(currentInfo.igboYear, 1, 9999, getState(a).y);
      var targetMonth = clampInt(currentInfo.igboMonth, 1, 13, 1);
      var todayIso = String(currentInfo.todayIso || a.getAttribute("data-today-iso") || "");
      var currentState = getState(a);

      if (currentState.y !== targetYear && navigator.onLine) {
        hardNav(targetYear, targetMonth);
        return;
      }

      setState(a, targetYear, targetMonth);
      var chosen = syncVisibleMonth(a, findCellByIsoInApp(a, todayIso));
      scrollChosenIntoView(chosen);
    }).catch(function(){
      syncVisibleMonth(a);
    });
  }

  function goToRealCurrentMonth(a){
    deriveCurrentIgboData(a).then(function(currentInfo){
      if (!currentInfo) {
        syncVisibleMonth(a);
        return;
      }

      var targetYear = clampInt(currentInfo.igboYear, 1, 9999, getState(a).y);
      var targetMonth = clampInt(currentInfo.igboMonth, 1, 13, 1);
      var currentState = getState(a);

      if (currentState.y !== targetYear && navigator.onLine) {
        hardNav(targetYear, targetMonth);
        return;
      }

      setState(a, targetYear, targetMonth);
      var chosen = syncVisibleMonth(a);
      scrollChosenIntoView(chosen);
    }).catch(function(){
      syncVisibleMonth(a);
    });
  }

  function populateRanges(a){
    var sel = qs("#igcal-gregorian-range", a);
    if (!sel) return;

    var st = getState(a);
    var center = st.y;
    var fromY = Math.max(1, center - 30);
    var toY   = Math.min(9999, center + 30);

    sel.innerHTML = "";
    var optMap = Object.create(null);

    for (var y = fromY; y <= toY; y++){
      var o = document.createElement("option");
      o.value = String(y);
      o.textContent = y + " — Loading…";
      sel.appendChild(o);
      optMap[y] = o;
    }
    sel.value = String(center);

    sel.onchange = function(){
      var y2 = clampInt(sel.value, 1, 9999, center);
      setState(a, y2, 1);

      if (!navigator.onLine) {
        syncVisibleMonth(a);
        return;
      }

      hardNav(y2, 1);
    };

    function setLabel(y, ys, ysNext){
      var o = optMap[y];
      if (!o) return;

      if (!ys) {
        o.textContent = y + " — Unavailable";
        return;
      }

      var label = "Starts: " + ys;
      if (ysNext) {
        var nextDt = parseYmdToUtcDate(ysNext);
        if (nextDt) {
          var endDt = new Date(nextDt.getTime() - 86400 * 1000);
          label = "Starts: " + ys + " → Ends: " + utcDateToYmd(endDt);
        }
      }
      o.textContent = y + " — " + label;
    }

    function fillOne(y){
      return Promise.all([fetchYearStart(a, y), fetchYearStart(a, y + 1)]).then(function(res){
        setLabel(y, res[0], res[1]);
      });
    }

    fillOne(center);

    var queue = [];
    for (var yy = fromY; yy <= toY; yy++){
      if (yy !== center) queue.push(yy);
    }

    (function batch(){
      if (!queue.length) return;
      var b = queue.splice(0, 6);
      Promise.all(b.map(fillOne)).then(function(){
        setTimeout(batch, 35);
      }).catch(function(){
        setTimeout(batch, 120);
      });
    })();
  }

  function bindDayClicks(a){
    qsa(".mk-cal-cell__button", a).forEach(function(btn){
      if (btn.__igcalBound === "1") return;
      btn.__igcalBound = "1";

      btn.addEventListener("click", function(e){
        e.preventDefault();
        var cell = btn.closest(".mk-cal-cell");
        if (!cell) return;
        updateViewedDaySummary(a, cell);
      });
    });
  }

  function chooseDefaultViewedCell(a, detail){
    if (detail && detail.defaultIso) {
      var byIso = findCellByIsoInApp(a, detail.defaultIso);
      if (byIso) return byIso;
    }
    return firstSelectableCellInVisibleMonth(a);
  }

  function navWithinRenderedYear(a, targetYear, targetMonth, preferredIso){
    var current = getState(a);
    var sameYear = current.y === targetYear;
    var online = navigator.onLine;

    if (!sameYear && online) {
      hardNav(targetYear, targetMonth);
      return;
    }

    setState(a, targetYear, targetMonth);

    var preferredCell = null;
    if (preferredIso) {
      preferredCell = findCellByIsoInApp(a, preferredIso);
    }

    var chosen = syncVisibleMonth(a, preferredCell);
    scrollChosenIntoView(chosen);
  }

  function bind(){
    var a = app();
    if (!a) return;

    var st = getState(a);

    var prevDay = qs("#igcal-prev-day", a);
    var nextDay = qs("#igcal-next-day", a);
    var todayDay = qs("#igcal-today-day", a);

    var prevMonth = qs("#igcal-prev-month", a);
    var nextMonth = qs("#igcal-next-month", a);
    var thisMonth = qs("#igcal-this-month", a);

    var monthSel = qs("#igcal-month-select", a);
    var yearSel  = qs("#igcal-year-select", a);
    var yearBtn  = qs("#igcal-apply-year", a);

    if (yearSel) yearSel.value = String(st.y);
    if (monthSel) monthSel.value = String(st.m);

    if (yearBtn && !yearBtn.__igcalBound) {
      yearBtn.__igcalBound = "1";
      yearBtn.addEventListener("click", function(){
        var cur = getState(a);
        var y2 = clampInt(yearSel ? yearSel.value : cur.y, 1, 9999, cur.y);
        setState(a, y2, 1);

        if (!navigator.onLine || y2 === cur.y) {
          syncVisibleMonth(a);
          return;
        }

        hardNav(y2, 1);
      });
    }

    if (yearSel && !yearSel.__igcalBound) {
      yearSel.__igcalBound = "1";
      yearSel.addEventListener("keydown", function(e){
        if (e.key === "Enter") {
          e.preventDefault();
          var cur = getState(a);
          var y2 = clampInt(yearSel.value, 1, 9999, cur.y);
          setState(a, y2, 1);

          if (!navigator.onLine || y2 === cur.y) {
            syncVisibleMonth(a);
            return;
          }

          hardNav(y2, 1);
        }
      });
    }

    if (monthSel && !monthSel.__igcalBound) {
      monthSel.__igcalBound = "1";
      monthSel.addEventListener("change", function(){
        var cur = getState(a);
        var m2 = clampInt(monthSel.value, 1, 13, cur.m);
        setState(a, cur.y, m2);
        syncVisibleMonth(a);
      });
    }

    function navMonth(delta){
      var cur = getState(a);
      var y2 = cur.y;
      var m2 = cur.m + delta;

      if (m2 < 1) {
        m2 = 13;
        y2 = Math.max(1, cur.y - 1);
      } else if (m2 > 13) {
        m2 = 1;
        y2 = Math.min(9999, cur.y + 1);
      }

      navWithinRenderedYear(a, y2, m2, "");
    }

    if (prevDay && !prevDay.__igcalBound) {
      prevDay.__igcalBound = "1";
      prevDay.addEventListener("click", function(e){
        e.preventDefault();
        moveViewedDay(a, -1);
      });
    }

    if (nextDay && !nextDay.__igcalBound) {
      nextDay.__igcalBound = "1";
      nextDay.addEventListener("click", function(e){
        e.preventDefault();
        moveViewedDay(a, 1);
      });
    }

    if (todayDay && !todayDay.__igcalBound) {
      todayDay.__igcalBound = "1";
      todayDay.addEventListener("click", function(e){
        e.preventDefault();
        goToRealToday(a);
      });
    }

    if (prevMonth && !prevMonth.__igcalBound) {
      prevMonth.__igcalBound = "1";
      prevMonth.addEventListener("click", function(e){
        e.preventDefault();
        navMonth(-1);
      });
    }

    if (nextMonth && !nextMonth.__igcalBound) {
      nextMonth.__igcalBound = "1";
      nextMonth.addEventListener("click", function(e){
        e.preventDefault();
        navMonth(1);
      });
    }

    if (thisMonth && !thisMonth.__igcalBound) {
      thisMonth.__igcalBound = "1";
      thisMonth.addEventListener("click", function(e){
        e.preventDefault();
        goToRealCurrentMonth(a);
      });
    }

    populateRanges(a);
    updateMonthSummary(a);
    updateYearSummary(a);
    updateRangeSummary(a);
    updateCurrentSummary(a);
    setLoading(a, true);
  }

  function onRendered(ev){
    var a = app();
    if (!a) return;

    setLoading(a, false);

    var st = getState(a);
    showOnlyMonth(a, clampInt(st.m, 1, 13, 1));
    bindDayClicks(a);
    updateCurrentSummary(a);
    updateMonthSummary(a);
    updateYearSummary(a);
    updateRangeSummary(a);

    var detail = ev && ev.detail ? ev.detail : null;
    updateViewedDaySummary(a, chooseDefaultViewedCell(a, detail));
    syncSelectors(a);
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", bind);
  else bind();

  window.addEventListener("igcal:rendered", onRendered);
})();


/* ===== IGBO CALENDAR INTERACTION REFINEMENT PASS ===== */
(function () {
  var STORAGE_KEY = 'igcal_preferred_day_iso_v1';

  function qs(sel, root) {
    return (root || document).querySelector(sel);
  }

  function qsa(sel, root) {
    return Array.prototype.slice.call((root || document).querySelectorAll(sel));
  }

  function text(el) {
    return ((el && el.textContent) || '').trim();
  }

  function isIso(v) {
    return /^\d{4}-\d{2}-\d{2}$/.test(v || '');
  }

  function parseIsoParts(iso) {
    if (!isIso(iso)) return null;
    var m = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return null;
    return {
      year: parseInt(m[1], 10),
      month: parseInt(m[2], 10),
      day: parseInt(m[3], 10)
    };
  }

  function fmtIsoHuman(iso) {
    if (!isIso(iso)) return '';
    var d = new Date(iso + 'T00:00:00Z');
    return d.toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC'
    });
  }

  function getMount() {
    return qs('#igcal-mount');
  }

  function getCurrentSummary() {
    return qs('#igcal-current-summary');
  }

  function getViewedMonthSummary() {
    return qs('#igcal-viewed-month-summary');
  }

  function getViewedYearSummary() {
    return qs('#igcal-viewed-year-summary');
  }

  function getYearRangeSummary() {
    return qs('#igcal-year-range-summary');
  }

  function getDayCells() {
    return qsa('.mk-cal-cell, .igcal-day-cell, .ig-day');
  }

  function getCellIso(cell) {
    if (!cell) return '';
    var isoNode = qs('.mk-cal-iso', cell);
    var iso = text(isoNode);
    return isIso(iso) ? iso : '';
  }

  function getCellButton(cell) {
    return qs('.mk-cal-cell__button', cell) || cell;
  }

  function getVisibleCellData() {
    return getDayCells()
      .map(function (cell) {
        var iso = getCellIso(cell);
        return {
          cell: cell,
          iso: iso,
          parts: parseIsoParts(iso)
        };
      })
      .filter(function (x) {
        return !!x.parts;
      });
  }

  function getTodayCell() {
    return qs('.mk-cal-cell--today, .mk-cal-cell.is-today, .igcal-day-cell.is-today, .ig-day.is-today');
  }

  function getSelectedCell() {
    return qs('.mk-cal-cell.is-selected, .igcal-day-cell.is-selected, .ig-day.is-selected');
  }

  function rememberPreferredIso(iso) {
    if (!isIso(iso)) return;
    try {
      sessionStorage.setItem(STORAGE_KEY, iso);
    } catch (e) {}
  }

  function readPreferredIso() {
    try {
      return sessionStorage.getItem(STORAGE_KEY) || '';
    } catch (e) {
      return '';
    }
  }

  function markSelectedCell(cell) {
    getDayCells().forEach(function (c) {
      c.classList.remove('is-selected');
    });
    if (cell) {
      cell.classList.add('is-selected');
      var iso = getCellIso(cell);
      if (iso) rememberPreferredIso(iso);
    }
    refreshTodaySelectedState();
  }

  function refreshTodaySelectedState() {
    getDayCells().forEach(function (c) {
      c.classList.remove('igcal-is-today-only', 'igcal-is-selected-only', 'igcal-is-today-and-selected');
      var isToday = c.classList.contains('mk-cal-cell--today') || c.classList.contains('is-today');
      var isSelected = c.classList.contains('is-selected');
      if (isToday && isSelected) {
        c.classList.add('igcal-is-today-and-selected');
      } else if (isToday) {
        c.classList.add('igcal-is-today-only');
      } else if (isSelected) {
        c.classList.add('igcal-is-selected-only');
      }
    });
  }

  function enhanceDayCells() {
    getDayCells().forEach(function (cell) {
      if (cell.dataset.igRefined === '1') return;
      cell.dataset.igRefined = '1';

      if (!cell.hasAttribute('tabindex')) {
        cell.setAttribute('tabindex', '0');
      }

      cell.addEventListener('click', function () {
        markSelectedCell(cell);
      });

      cell.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          getCellButton(cell).click();
        }
      });
    });
  }

  function chooseBestCellForPreferredDay() {
    var preferredIso = readPreferredIso();
    var pref = parseIsoParts(preferredIso);
    var visible = getVisibleCellData();

    if (!visible.length) return null;
    if (!pref) return getTodayCell() || visible[0].cell;

    var exact = visible.find(function (x) {
      return x.iso === preferredIso;
    });
    if (exact) return exact.cell;

    var sameDay = visible.find(function (x) {
      return x.parts.day === pref.day;
    });
    if (sameDay) return sameDay.cell;

    var sorted = visible.slice().sort(function (a, b) {
      return Math.abs(a.parts.day - pref.day) - Math.abs(b.parts.day - pref.day);
    });

    return sorted.length ? sorted[0].cell : (getTodayCell() || visible[0].cell);
  }

  function applyPreferredSelection() {
    if (getSelectedCell()) {
      refreshTodaySelectedState();
      return;
    }

    var target = chooseBestCellForPreferredDay();
    if (!target) return;

    markSelectedCell(target);
  }

  function getRenderedIsoRange() {
    var visible = getVisibleCellData();
    if (!visible.length) return null;

    var isos = visible
      .map(function (x) { return x.iso; })
      .filter(isIso)
      .sort();

    if (!isos.length) return null;

    return {
      start: isos[0],
      end: isos[isos.length - 1]
    };
  }

  function getRenderedMonthName() {
    var monthSelect = qs('#igcal-month-select');
    if (monthSelect && monthSelect.selectedOptions && monthSelect.selectedOptions[0]) {
      return text(monthSelect.selectedOptions[0]).replace(/^\d+\s+—\s+/, '');
    }

    var titleNode = qs('.mk-cal-month__title, .month-title, .igcal-month-title');
    return text(titleNode);
  }

  function getRenderedMonthNumber() {
    var monthSelect = qs('#igcal-month-select');
    if (monthSelect && monthSelect.value) return monthSelect.value;
    return '';
  }

  function getRenderedYear() {
    var yearSelect = qs('#igcal-year-select');
    if (yearSelect && yearSelect.value) return yearSelect.value;
    return '';
  }

  function buildBadge(label, value, detail, extraClass) {
  var cls = 'igcal-mini-badge' + (extraClass ? ' ' + extraClass : '');
  var html = '<span class="' + cls + '">';

  if (label) {
    html += '<span class="igcal-mini-badge__label">' + label + ':</span>';
  }

  html += '<span class="igcal-mini-badge__value">' + value + '</span>';

  if (detail) {
    html += '<span class="igcal-mini-badge__detail">' + detail + '</span>';
  }

  html += '</span>';
  return html;
}

  
  function upsertViewedMonthBadges() {
  var box = getViewedMonthSummary();
  var range = getRenderedIsoRange();
  if (!box || !range) return;

  var visible = getVisibleCellData();
  var monthName = getRenderedMonthName() || 'Month';
  var monthNo = getRenderedMonthNumber() || '';
  var dayCount = visible.length;

  var monthDetailMap = {
    '1': 'New Year (Mbido Afọ)',
    '2': 'Farm Clearing & Cleansing',
    '3': 'Fasting & Offering',
    '4': 'Planting Season',
    '5': 'Masquerade Rites / Knowledge',
    '6': 'Yam Festival / Rituals',
    '7': 'New Yam Festival',
    '8': 'Ancestral Veneration',
    '9': 'Ofala Festival',
    '10': 'Creation Myths / Offerings',
    '11': 'Spiritual Cleansing',
    '12': 'End-Year Offerings',
    '13': 'Intercalary Rituals'
  };

  var monthLine = monthNo ? (monthNo + ' - ' + monthName) : monthName;
  var monthDetail = monthDetailMap[String(monthNo)] || '';

  var html = ''
    + '<div class="igcal-badge-row" data-ig-month-badges="1">'
    + buildBadge('', monthLine, monthDetail, 'igcal-mini-badge--month')
    + buildBadge('Days', String(dayCount))
    + buildBadge('Start', fmtIsoHuman(range.start))
    + buildBadge('End', fmtIsoHuman(range.end))
    + '</div>';

  var old = qs('[data-ig-month-badges="1"]', box);
  if (old) {
    old.outerHTML = html;
  } else {
    box.insertAdjacentHTML('beforeend', html);
  }
}
  

  function upsertViewedYearSummary() {
    var box = getViewedYearSummary();
    var range = getRenderedIsoRange();
    if (!box || !range) return;

    var year = getRenderedYear() || '';
    var html = ''
      + '<div class="igcal-facts" data-ig-year-facts="1">'
      +   '<div class="igcal-fact"><strong>Viewed Year:</strong> ' + year + '</div>'
      +   '<div class="igcal-fact"><strong>Gregorian Start:</strong> ' + fmtIsoHuman(range.start) + '</div>'
      +   '<div class="igcal-fact"><strong>Gregorian End:</strong> ' + fmtIsoHuman(range.end) + '</div>'
      +   '<div class="igcal-fact"><strong>Total Igbo Months:</strong> 13</div>'
      + '</div>';

    var old = qs('[data-ig-year-facts="1"]', box);
    if (old) {
      old.outerHTML = html;
    } else {
      box.insertAdjacentHTML('beforeend', html);
    }
  }

  function upsertYearRangeSummary() {
    var box = getYearRangeSummary();
    var range = getRenderedIsoRange();
    if (!box || !range) return;

    var year = getRenderedYear() || '';
    var html = ''
      + '<div class="igcal-facts" data-ig-range-facts="1">'
      +   '<div class="igcal-fact"><strong>Viewed Year:</strong> ' + year + '</div>'
      +   '<div class="igcal-fact"><strong>Gregorian Start:</strong> ' + fmtIsoHuman(range.start) + '</div>'
      +   '<div class="igcal-fact"><strong>Gregorian End:</strong> ' + fmtIsoHuman(range.end) + '</div>'
      +   '<div class="igcal-fact"><strong>Coverage:</strong> Full rendered calendar span</div>'
      + '</div>';

    var old = qs('[data-ig-range-facts="1"]', box);
    if (old) {
      old.outerHTML = html;
    } else {
      box.insertAdjacentHTML('beforeend', html);
    }
  }

  function upsertStaticCurrentGregorianRange() {
    var box = getCurrentSummary();
    var range = getRenderedIsoRange();
    if (!box || !range) return;

    var line = qs('[data-gregorian-month-range="1"]', box);
    if (!line) {
      line = document.createElement('div');
      line.className = 'igcal-summary-line';
      line.setAttribute('data-gregorian-month-range', '1');
      box.appendChild(line);
    }

    line.innerHTML = '<strong>Gregorian Month Range:</strong> ' + fmtIsoHuman(range.start) + ' — ' + fmtIsoHuman(range.end);
  }

  function keepPanelHeightsStable() {
    [getCurrentSummary(), getViewedMonthSummary(), getViewedYearSummary(), getYearRangeSummary()].forEach(function (box) {
      if (!box) return;
      if (!box.style.minHeight) {
        box.style.minHeight = '110px';
      }
    });
  }

  function runRefinementPass() {
    enhanceDayCells();
    applyPreferredSelection();
    refreshTodaySelectedState();
    upsertStaticCurrentGregorianRange();
    upsertViewedMonthBadges();
    upsertViewedYearSummary();
    upsertYearRangeSummary();
    keepPanelHeightsStable();
  }

  function bindPersistenceButtons() {
    [
      '#igcal-prev-day',
      '#igcal-next-day',
      '#igcal-today-day',
      '#igcal-prev-month',
      '#igcal-this-month',
      '#igcal-next-month',
      '#igcal-apply-year',
      '#igcal-month-select',
      '#igcal-year-select'
    ].forEach(function (sel) {
      var el = qs(sel);
      if (!el || el.dataset.igBoundPersist === '1') return;
      el.dataset.igBoundPersist = '1';

      var handler = function () {
        var selected = getSelectedCell();
        var iso = selected ? getCellIso(selected) : '';
        if (iso) rememberPreferredIso(iso);
      };

      el.addEventListener('click', handler);
      el.addEventListener('change', handler);
    });
  }

  function initRefinement() {
    bindPersistenceButtons();
    runRefinementPass();

    var mount = getMount();
    if (mount && !mount.dataset.igRefineObserverBound && window.MutationObserver) {
      mount.dataset.igRefineObserverBound = '1';
      var obs = new MutationObserver(function () {
        bindPersistenceButtons();
        runRefinementPass();
      });
      obs.observe(mount, { childList: true, subtree: true });
    }

    setTimeout(runRefinementPass, 100);
    setTimeout(runRefinementPass, 350);
    setTimeout(runRefinementPass, 800);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRefinement);
  } else {
    initRefinement();
  }
})();


/* ===== EXPORT / SHARE FEATURES + INLINE YEAR CONTROLS (SAFE STABILIZATION PASS) ===== */
(function () {
  'use strict';

  function qs(sel, root) {
    return (root || document).querySelector(sel);
  }

  function text(el) {
    return ((el && (el.innerText || el.textContent)) || '').replace(/\s+/g, ' ').trim();
  }

  function escHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function bindOnce(el, type, key, handler) {
    if (!el) return;
    var attr = 'data-ig-bound-' + key;
    if (el.getAttribute(attr) === '1') return;
    el.setAttribute(attr, '1');
    el.addEventListener(type, handler);
  }

  function copyPlain(value, statusTarget) {
    var v = String(value || '').trim();
    if (!v) return Promise.resolve(false);

    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(v).then(function () {
        if (statusTarget) setStatus(statusTarget, 'Copied successfully.');
        return true;
      }).catch(function () {
        return Promise.resolve(legacyCopy(v, statusTarget));
      });
    }

    return Promise.resolve(legacyCopy(v, statusTarget));
  }

  function legacyCopy(value, statusTarget) {
    try {
      var ta = document.createElement('textarea');
      ta.value = value;
      ta.setAttribute('readonly', 'readonly');
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      ta.style.top = '0';
      document.body.appendChild(ta);
      ta.select();
      var ok = document.execCommand('copy');
      document.body.removeChild(ta);
      if (statusTarget) setStatus(statusTarget, ok ? 'Copied successfully.' : 'Copy failed.');
      return ok;
    } catch (_) {
      if (statusTarget) setStatus(statusTarget, 'Copy failed.');
      return false;
    }
  }

  function sharePayload(payload, statusTarget) {
    if (navigator.share) {
      return navigator.share({
        title: payload.title,
        text: payload.text,
        url: payload.url || window.location.href
      }).then(function () {
        if (statusTarget) setStatus(statusTarget, 'Shared successfully.');
        return true;
      }).catch(function () {
        return copyPlain(payload.text, statusTarget).then(function (ok) {
          if (ok && statusTarget) setStatus(statusTarget, 'Share not available here. Copied instead.');
          return ok;
        });
      });
    }

    return copyPlain(payload.text, statusTarget).then(function (ok) {
      if (ok && statusTarget) setStatus(statusTarget, 'Share not available here. Copied instead.');
      return ok;
    });
  }

  function printPayload(title, content) {
    var w = window.open('', '_blank', 'width=860,height=700');
    if (!w) return false;

    var css = ''
      + 'body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;margin:28px;color:#222;}'
      + 'h1{font-size:24px;margin:0 0 12px;color:#6f4724;}'
      + '.meta{color:#555;margin-bottom:16px;}'
      + '.card{border:1px solid #d8c7aa;border-radius:14px;padding:18px;background:#fffaf2;line-height:1.55;white-space:pre-wrap;}';

    w.document.open();
    w.document.write(
      '<!doctype html><html><head><meta charset="utf-8"><title>' + escHtml(title) + '</title><style>' + css + '</style></head><body>' +
      '<h1>' + escHtml(title) + '</h1>' +
      '<div class="meta">Printed from Igbo Calendar • ' + escHtml(window.location.href) + '</div>' +
      '<div class="card">' + escHtml(content) + '</div>' +
      '</body></html>'
    );
    w.document.close();
    w.focus();
    setTimeout(function () {
      try { w.print(); } catch (_) {}
    }, 200);
    return true;
  }

  function getSelectedCell() {
    return qs('.mk-cal-cell.is-selected, .igcal-day-cell.is-selected, .ig-day.is-selected');
  }

  function getTodayCell() {
    return qs('.mk-cal-cell--today, .mk-cal-cell.is-today, .igcal-day-cell.is-today, .ig-day.is-today');
  }

  function getActiveCell() {
    return getSelectedCell() || getTodayCell();
  }

  function getCellIso(cell) {
    if (!cell) return '';
    var iso = String(cell.getAttribute('data-iso') || '').trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(iso)) return iso;

    var isoNode = qs('.mk-cal-iso', cell);
    var txt = text(isoNode);
    return /^\d{4}-\d{2}-\d{2}$/.test(txt) ? txt : '';
  }

  function getViewedDayText() {
    return text(qs('#igcal-viewed-day-summary'));
  }

  function getViewedMonthText() {
    return text(qs('#igcal-viewed-month-summary'));
  }

  function getViewedYearText() {
    var t = text(qs('#igcal-viewed-year-summary'));
    if (t) return t;

    var y = getYearValue();
    return 'Viewed Year\nYear: ' + (y || '—');
  }

  function getYearRangeText() {
    var t = text(qs('#igcal-year-range-summary'));
    if (t) return t;
    return 'Year Start / End';
  }

  function getMonthName() {
    var sel = qs('#igcal-month-select');
    if (sel && sel.selectedOptions && sel.selectedOptions[0]) {
      return text(sel.selectedOptions[0]).replace(/^\d+\s+—\s+/, '');
    }
    return '';
  }

  function getYearValue() {
    var sel = qs('#igcal-year-select');
    return sel ? String(sel.value || '') : '';
  }

  function buildDayPayload() {
    var iso = getCellIso(getActiveCell());
    var summary = getViewedDayText();
    var monthName = getMonthName();
    var year = getYearValue();
    var url = window.location.href;

    var lines = [
      'Igbo Calendar — Viewed Day',
      summary || 'Viewed day summary unavailable.'
    ];

    if (iso) lines.push('Gregorian ISO: ' + iso);
    if (monthName || year) lines.push('Context: ' + [monthName, year].filter(Boolean).join(' • '));
    lines.push('URL: ' + url);

    return {
      title: 'Igbo Calendar — Viewed Day',
      text: lines.join('\n'),
      url: url
    };
  }

  function buildMonthPayload() {
    var summary = getViewedMonthText();
    var monthName = getMonthName();
    var year = getYearValue();
    var url = window.location.href;

    var lines = [
      'Igbo Calendar — Viewed Month',
      summary || 'Viewed month summary unavailable.'
    ];

    if (monthName || year) lines.push('Context: ' + [monthName, year].filter(Boolean).join(' • '));
    lines.push('URL: ' + url);

    return {
      title: 'Igbo Calendar — Viewed Month',
      text: lines.join('\n'),
      url: url
    };
  }

  function buildYearPayload() {
    var year = getYearValue();
    var summary = getViewedYearText();
    var url = window.location.href;

    var lines = [
      'Igbo Calendar — Viewed Year',
      summary || 'Viewed year summary unavailable.'
    ];

    if (year) lines.push('Year: ' + year);
    lines.push('URL: ' + url);

    return {
      title: 'Igbo Calendar — Viewed Year',
      text: lines.join('\n'),
      url: url
    };
  }

  function buildRangePayload() {
    var summary = getYearRangeText();
    var year = getYearValue();
    var url = window.location.href;

    var lines = [
      'Igbo Calendar — Year Start / End',
      summary || 'Year range unavailable.'
    ];

    if (year) lines.push('Viewed Year: ' + year);
    lines.push('URL: ' + url);

    return {
      title: 'Igbo Calendar — Year Start / End',
      text: lines.join('\n'),
      url: url
    };
  }

  function setStatus(kind, msg) {
    var el = qs('[data-ig-share-status="' + kind + '"]');
    if (el) el.textContent = msg || '';
  }

  function ensureActionBar(targetSelector, kind) {
    var target = qs(targetSelector);
    if (!target || !target.parentNode) return null;

    var existing = qs('[data-ig-share-bar="' + kind + '"]', target.parentNode);
    if (existing) return existing;

    var bar = document.createElement('div');
    bar.className = 'igcal-sharebar';
    bar.setAttribute('data-ig-share-bar', kind);

    if (kind === 'day') {
      bar.innerHTML =
        '<button type="button" class="igcal-sharebar__btn" data-ig-copy-day="1">Copy Viewed Day</button>' +
        '<button type="button" class="igcal-sharebar__btn" data-ig-share-day="1">Share Viewed Day</button>' +
        '<button type="button" class="igcal-sharebar__btn" data-ig-print-day="1">Print Day</button>' +
        '<div class="igcal-sharebar__status" data-ig-share-status="day" aria-live="polite"></div>';
    } else if (kind === 'month') {
      bar.innerHTML =
        '<button type="button" class="igcal-sharebar__btn" data-ig-copy-month="1">Copy Viewed Month</button>' +
        '<button type="button" class="igcal-sharebar__btn" data-ig-share-month="1">Share Viewed Month</button>' +
        '<button type="button" class="igcal-sharebar__btn" data-ig-print-month="1">Print Month</button>' +
        '<div class="igcal-sharebar__status" data-ig-share-status="month" aria-live="polite"></div>';
    }

    target.insertAdjacentElement('afterend', bar);
    return bar;
  }

  function bindDayMonthShareButtons() {
    var dayBar = ensureActionBar('#igcal-viewed-day-summary', 'day');
    var monthBar = ensureActionBar('#igcal-viewed-month-summary', 'month');

    var copyDay = qs('[data-ig-copy-day="1"]', dayBar || document);
    var shareDay = qs('[data-ig-share-day="1"]', dayBar || document);
    var printDay = qs('[data-ig-print-day="1"]', dayBar || document);

    var copyMonth = qs('[data-ig-copy-month="1"]', monthBar || document);
    var shareMonth = qs('[data-ig-share-month="1"]', monthBar || document);
    var printMonth = qs('[data-ig-print-month="1"]', monthBar || document);

    bindOnce(copyDay, 'click', 'copy-day', function () {
      var payload = buildDayPayload();
      copyPlain(payload.text, 'day');
    });

    bindOnce(shareDay, 'click', 'share-day', function () {
      var payload = buildDayPayload();
      sharePayload(payload, 'day');
    });

    bindOnce(printDay, 'click', 'print-day', function () {
      var payload = buildDayPayload();
      var ok = printPayload(payload.title, payload.text);
      setStatus('day', ok ? 'Print dialog opened.' : 'Print could not open.');
    });

    bindOnce(copyMonth, 'click', 'copy-month', function () {
      var payload = buildMonthPayload();
      copyPlain(payload.text, 'month');
    });

    bindOnce(shareMonth, 'click', 'share-month', function () {
      var payload = buildMonthPayload();
      sharePayload(payload, 'month');
    });

    bindOnce(printMonth, 'click', 'print-month', function () {
      var payload = buildMonthPayload();
      var ok = printPayload(payload.title, payload.text);
      setStatus('month', ok ? 'Print dialog opened.' : 'Print could not open.');
    });
  }

  function disableYearNavButton(id) {
    var oldEl = qs('#' + id);
    if (!oldEl) return null;

    if (oldEl.dataset.igNavDisabled === '1') return oldEl;

    var newEl = oldEl.cloneNode(true);
    newEl.dataset.igNavDisabled = '1';
    oldEl.parentNode.replaceChild(newEl, oldEl);

    newEl.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === 'function') {
        e.stopImmediatePropagation();
      }
      return false;
    });

    newEl.setAttribute('aria-disabled', 'true');
    newEl.title = 'Temporarily disabled during JS stabilization';
    return newEl;
  }

  function rebindCleanClick(id, handler) {
    var oldEl = qs('#' + id);
    if (!oldEl) return null;

    if (oldEl.dataset.igRebound === '1') return oldEl;

    var newEl = oldEl.cloneNode(true);
    newEl.dataset.igRebound = '1';
    oldEl.parentNode.replaceChild(newEl, oldEl);

    newEl.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === 'function') {
        e.stopImmediatePropagation();
      }
      handler(e);
    });

    return newEl;
  }

  
  function bindInlineYearButtons() {
  rebindCleanClick('igcal-year-copy', function () {
    var payload = buildYearPayload();
    copyPlain(payload.text);
  });

  rebindCleanClick('igcal-year-share', function () {
    var payload = buildYearPayload();
    sharePayload(payload);
  });

  rebindCleanClick('igcal-year-print', function () {
    var payload = buildYearPayload();
    printPayload(payload.title, payload.text);
  });

  rebindCleanClick('igcal-range-copy', function () {
    var payload = buildRangePayload();
    copyPlain(payload.text);
  });

  rebindCleanClick('igcal-range-share', function () {
    var payload = buildRangePayload();
    sharePayload(payload);
  });

  rebindCleanClick('igcal-range-print', function () {
    var payload = buildRangePayload();
    printPayload(payload.title, payload.text);
  });
}
  
  function bootTailPass() {
    bindDayMonthShareButtons();
    bindInlineYearButtons();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootTailPass);
  } else {
    bootTailPass();
  }

  window.addEventListener('load', function () {
    setTimeout(bootTailPass, 120);
  });
})();