/* /public/igbo-calendar/calendar-ux.js */
(function () {
  "use strict";

  window.__igcalUxLoaded = "2026-03-17-day-month-control-separation";

  function qs(sel, root){ return (root || document).querySelector(sel); }
  function qsa(sel, root){ return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

  function clampInt(v, lo, hi, fallback) {
    var s = (v === null || v === undefined) ? "" : String(v);
    var n = parseInt(s, 10);
    if (!isFinite(n)) return fallback;
    if (n < lo) return lo;
    if (n > hi) return hi;
    return n;
  }

  function app(){
    var all = document.querySelectorAll('[data-app="igbo-calendar"]');
    return (all && all.length) ? all[all.length - 1] : null;
  }

  function getState(a){
    var yAttr = a.getAttribute("data-selected-year");
    var y = clampInt(yAttr, 1, 9999, (new Date()).getUTCFullYear());

    var mAttr = a.getAttribute("data-selected-month");
    var m = clampInt(mAttr, 1, 13, 1);

    return { y: y, m: m };
  }

  function setState(a, y, m){
    a.setAttribute("data-selected-year", String(y));
    a.setAttribute("data-selected-month", String(m));
  }

  function hardNav(y, m){
    window.location.href =
      "/igbo-calendar/?year=" + encodeURIComponent(String(y)) +
      "&m=" + encodeURIComponent(String(m));
  }

  function setLoading(a, isLoading){
    var loading = qs(".igcal-loading", a);
    var mount = qs("#igcal-mount", a);
    if (loading) loading.hidden = !isLoading;
    if (mount) mount.setAttribute("aria-busy", isLoading ? "true" : "false");
  }

  function showOnlyMonth(a, m){
    var mount = qs("#igcal-mount", a);
    if (!mount) return null;

    var chosen = null;
    var list = mount.querySelectorAll('.igcal-month[data-ig-month]');
    for (var i = 0; i < list.length; i++) {
      var s = list[i];
      var mm = parseInt(s.getAttribute("data-ig-month") || "0", 10);
      var on = (mm === m);
      s.hidden = !on;
      s.setAttribute("aria-hidden", on ? "false" : "true");
      if (on) chosen = s;
    }
    return chosen;
  }

  function parseYmdToUtcDate(s){
    var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s || ""));
    if (!m) return null;
    var y = parseInt(m[1], 10), mo = parseInt(m[2], 10), d = parseInt(m[3], 10);
    var dt = new Date(Date.UTC(y, mo - 1, d, 0, 0, 0));
    var iso = dt.getUTCFullYear() + "-" +
      String(dt.getUTCMonth()+1).padStart(2,"0") + "-" +
      String(dt.getUTCDate()).padStart(2,"0");
    if (iso !== (m[1] + "-" + m[2] + "-" + m[3])) return null;
    return dt;
  }

  function utcDateToYmd(dt){
    return dt.getUTCFullYear() + "-" +
      String(dt.getUTCMonth()+1).padStart(2,"0") + "-" +
      String(dt.getUTCDate()).padStart(2,"0");
  }

  function formatUtcLongDate(iso) {
    try {
      return new Date(iso + "T00:00:00Z").toLocaleDateString(undefined, {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC"
      });
    } catch (e) {
      return iso || "";
    }
  }

  function isLeapYear(y){
    if (y % 400 === 0) return true;
    if (y % 100 === 0) return false;
    return (y % 4 === 0);
  }

  function getMonthDays(y, m){
    if (m === 7) return 29;
    if (m === 1 && isLeapYear(y)) return 29;
    return 28;
  }

  function monthName(m){
    var map = {
      1: "Ọnwa Mbụ",
      2: "Ọnwa Abụọ",
      3: "Ọnwa Ife Eke",
      4: "Ọnwa Anọ",
      5: "Ọnwa Agwụ",
      6: "Ọnwa Ifejiọkụ",
      7: "Ọnwa Alọm Chi / Asaa",
      8: "Ọnwa Ilo Mmụọ / Asatọ",
      9: "Ọnwa Ala / Itolu",
      10: "Ọnwa Okike / Iri",
      11: "Ọnwa Ajala / Iri na otu",
      12: "Ọnwa Ede Ajala / Iri na abụọ",
      13: "Ọnwa Ụzọ Arụsị / Iri na atọ"
    };
    return map[m] || ("Month " + m);
  }

  function monthDetail(m){
    var map = {
      1: "Ọnwa Mbụ (Feb–Mar): New Year (Mbido Afọ)",
      2: "Ọnwa Abụọ (Mar–Apr): Farm Clearing & Cleansing",
