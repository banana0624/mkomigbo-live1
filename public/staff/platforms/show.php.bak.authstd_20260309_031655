<?php
declare(strict_types=1);

require_once __DIR__ . '/../../_init.php';
auth_require_role('staff');

header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
header('Pragma: no-cache');
header('Expires: 0');

if (session_status() !== PHP_SESSION_ACTIVE) { @session_start(); }

if (!function_exists('h')) {
  function h(string $v): string { return htmlspecialchars($v, ENT_QUOTES, 'UTF-8'); }
}
if (!function_exists('u')) {
  function u(string $path): string { return function_exists('url_for') ? url_for($path) : $path; }
}
if (!function_exists('safe_return')) {
  function safe_return(string $raw, string $default): string {
    $raw = trim($raw);
    if ($raw === '') return $default;
    $raw = rawurldecode($raw);
    if ($raw === '' || $raw[0] !== '/') return $default;
    if (preg_match('~^//~', $raw)) return $default;
    if (preg_match('~^[a-z]+:~i', $raw)) return $default;
    if (!preg_match('~^/staff/~', $raw)) return $default;
    return $raw;
  }
}

if (!function_exists('redirect_to')) {
  function redirect_to(string $location): void {
    $location = str_replace(["\r","\n"], '', trim($location));
    if ($location === '') $location = '/staff/platforms/index.php';

    // If already an absolute app path, use as-is
    if ($location[0] === '/') {
      header('Location: ' . $location, true, 302);
      exit;
    }

    // Otherwise resolve through url_for if available
    if (function_exists('url_for')) {
      $location = (string)url_for($location);
    }

    header('Location: ' . $location, true, 302);
    exit;
  }
}

$pdo = db();
$id = (int)($_GET['id'] ?? 0);
$return = safe_return((string)($_GET['return'] ?? '/staff/platforms/index.php'), '/staff/platforms/index.php');

if ($id <= 0) {
  header('Location: ' . $return, true, 302);
  exit;
}

$st = $pdo->prepare("
  SELECT id, slug, name, description, status, is_public, sort_order, sections_json, created_at, updated_at, deleted_at
  FROM platforms
  WHERE id = ?
  LIMIT 1
");
$st->execute([$id]);
$row = $st->fetch(PDO::FETCH_ASSOC);

if (!$row) {
  http_response_code(404);
  echo "Platform not found.";
  exit;
}

$sections_pretty = '—';
if (!empty($row['sections_json'])) {
  $decoded = json_decode((string)$row['sections_json'], true);
  if ($decoded !== null) {
    $sections_pretty = json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
  } else {
    $sections_pretty = (string)$row['sections_json'];
  }
}
?>
