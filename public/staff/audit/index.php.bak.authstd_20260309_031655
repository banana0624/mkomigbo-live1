<?php
declare(strict_types=1);

require_once __DIR__ . '/../../_init.php';

mk_require_staff_login();

/**
 * Staff Audit Log Viewer
 * /public/staff/audit/index.php
 */

if (session_status() !== PHP_SESSION_ACTIVE) { @session_start(); }

header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
header('Pragma: no-cache');

function h(string $v): string {
  return htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
}

$pdo = db();

/* pagination */
$page  = max(1, (int)($_GET['page'] ?? 1));
$limit = 50;
$off   = ($page - 1) * $limit;

$rows = $pdo->prepare("
  SELECT id, ts, staff_user_id, event, uri, ip
  FROM staff_audit_log
  ORDER BY id DESC
  LIMIT :lim OFFSET :off
");

$rows->bindValue(':lim', $limit, PDO::PARAM_INT);
$rows->bindValue(':off', $off, PDO::PARAM_INT);
$rows->execute();

$data = $rows->fetchAll(PDO::FETCH_ASSOC);

$total = (int)$pdo->query("SELECT COUNT(*) FROM staff_audit_log")->fetchColumn();
$pages = max(1, (int)ceil($total / $limit));

?>
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Staff Audit Log</title>
<style>
body{font-family:system-ui;margin:40px;background:#fafafa}
table{border-collapse:collapse;width:100%;background:#fff}
th,td{border:1px solid #ddd;padding:8px;font-size:14px}
th{background:#f1f1f1;text-align:left}
.pagination{margin-top:20px}
.pagination a{margin-right:10px;text-decoration:none}
</style>
</head>

<body>

<h1>Staff Audit Log</h1>

<table>
<thead>
<tr>
<th>ID</th>
<th>Timestamp</th>
<th>User</th>
<th>Event</th>
<th>IP</th>
<th>URI</th>
</tr>
</thead>

<tbody>

<?php foreach ($data as $r): ?>
<tr>
<td><?= h((string)$r['id']) ?></td>
<td><?= h((string)$r['ts']) ?></td>
<td><?= h((string)$r['staff_user_id']) ?></td>
<td><?= h((string)$r['event']) ?></td>
<td><?= h((string)$r['ip']) ?></td>
<td><?= h((string)$r['uri']) ?></td>
</tr>
<?php endforeach; ?>

</tbody>
</table>

<div class="pagination">
<?php if ($page > 1): ?>
<a href="?page=<?= $page-1 ?>">Previous</a>
<?php endif; ?>

Page <?= $page ?> / <?= $pages ?>

<?php if ($page < $pages): ?>
<a href="?page=<?= $page+1 ?>">Next</a>
<?php endif; ?>
</div>

</body>
</html>