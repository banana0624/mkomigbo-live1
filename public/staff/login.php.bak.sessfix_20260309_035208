    h1{margin:0 0 10px;font-size:20px}
    label{display:block;font-size:12px;color:#374151;margin-top:10px}
    input{width:100%;padding:10px 12px;border:1px solid #cfd4dc;border-radius:12px;margin-top:6px;box-sizing:border-box}
    button{margin-top:14px;width:100%;padding:10px 12px;border:0;border-radius:12px;background:#111827;color:#fff;font-weight:650;cursor:pointer}
