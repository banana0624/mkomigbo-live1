<?php
declare(strict_types=1);

if (!ob_get_level()) { @ob_start(); }
require_once __DIR__ . '/../_init.php';

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
header('Pragma: no-cache');
header('Expires: 0');

if (!function_exists('h')) {
  function h(string $v): string {
    return htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
  }
}

function is_post(): bool {
  return (($_SERVER['REQUEST_METHOD'] ?? '') === 'POST');
}

function safe_internal_return(string $v): string {
  $v = str_replace(["\r", "\n"], '', trim($v));
  if ($v === '') return '/staff/';
  if (preg_match('~^https?://~i', $v)) return '/staff/';
  if ($v[0] !== '/') $v = '/' . $v;
  return $v;
}

function redirect_to(string $path, int $code = 302): never {
  $dest = function_exists('url_for') ? (string)url_for($path) : $path;
  $dest = str_replace(["\r", "\n"], '', $dest);
  header('Location: ' . $dest, true, $code);
  exit;
}

if (!function_exists('mk_attempt_staff_login')) {
  $auth = null;
  if (defined('PRIVATE_PATH') && is_string(PRIVATE_PATH) && PRIVATE_PATH !== '') {
    $auth = rtrim(PRIVATE_PATH, "/\\") . '/functions/auth.php';
  } elseif (defined('APP_ROOT') && is_string(APP_ROOT) && APP_ROOT !== '') {
    $auth = rtrim(APP_ROOT, "/\\") . '/private/functions/auth.php';
  }
  if ($auth && is_file($auth)) {
    require_once $auth;
  }
}

if (function_exists('mk__session_start')) {
  mk__session_start();
} elseif (session_status() !== PHP_SESSION_ACTIVE) {
  @session_start();
}

$return = safe_internal_return((string)($_GET['return'] ?? ($_POST['return'] ?? '/staff/')));
$force  = ((string)($_GET['force'] ?? '') === '1');

$email = '';
$error = '';

if (((string)($_GET['forced'] ?? '')) === '1') {
  $error = 'Your session expired or was invalidated. Please sign in again.';
}

if (!$force && function_exists('mk_is_staff_logged_in') && mk_is_staff_logged_in()) {
  $uid = (int)($_SESSION['staff_user_id'] ?? 0);

  if (function_exists('mk_staff_session_version_valid') && !$force && !$uid ? false : !mk_staff_session_version_valid($uid)) {
    if (function_exists('mk_force_staff_logout_local')) {
      mk_force_staff_logout_local();
    }
  } else {
    redirect_to($return, 302);
  }
}

if (is_post()) {
  $email = trim((string)($_POST['email'] ?? ''));
  $pass  = (string)($_POST['password'] ?? '');

  if (!function_exists('mk_attempt_staff_login')) {
    $error = 'Auth system not loaded.';
  } else {
    $res = mk_attempt_staff_login($email, $pass);
    if (!empty($res['ok'])) {
      redirect_to($return, 302);
    }
    $error = (string)($res['error'] ?? 'Login failed.');
  }
}
?>
