        </p>

        <div class="actions" style="display:flex;gap:10px;flex-wrap:wrap;">
          <button class="btn btn-danger" type="submit">Yes, delete page</button>
          <a class="btn" href="<?php echo h($return); ?>">Cancel</a>
        </div>
      </form>
