<?php
declare(strict_types=1);

/**
 * /public/staff/tools/index.php
 * Staff Tools dashboard (registry-driven, hardened).
 *
 * - Always attempts tools_header.php (staff chrome + CSS)
 * - Falls back safely if shared include fails (prevents HTTP 500)
 * - Uses registry: APP_ROOT/private/functions/staff_tools_registry.php
 * - Groups by 'group' meta when present
 */

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

if (is_string($init) && $init !== '' && is_file($init)) {
require_once $init.php';
} else {
  // optional: throw a controlled error / fallback scan / log
}

if (session_status() !== PHP_SESSION_ACTIVE) { @session_start(); }

if (!function_exists('h')) {
  function h(string $v): string { return htmlspecialchars($v, ENT_QUOTES, 'UTF-8'); }
}
if (!function_exists('url_for')) {
  function url_for(string $path): string { return '/' . ltrim($path, '/'); }
}

/* Page vars for header */
$page_title = 'Tools • Staff';
$page_desc  = 'Diagnostics, audits, and scans (restricted).';
$nav_active = 'tools';
$active_nav = 'tools';

/* Try to load tools header safely */
$header_loaded = false;

if (function_exists('mk_require_shared')) {
  try {
    mk_require_shared('tools_header.php');
    $header_loaded = true;
  } catch (Throwable $e) {
    $header_loaded = false;
    $GLOBALS['__tools_header_error'] = $e->getMessage();
  }
}

if (!$header_loaded) {
  // fallback direct path
  $tools_header = (defined('PRIVATE_PATH') ? rtrim((string)PRIVATE_PATH, '/\\') . '/shared/tools_header.php' : '');
  if ($tools_header !== '' && is_file($tools_header)) {
    try {
      require $tools_header;
      $header_loaded = true;
    } catch (Throwable $e) {
      $header_loaded = false;
      $GLOBALS['__tools_header_error'] = $e->getMessage();
    }
  }
}

/* Absolute fallback (never 500) */
if (!$header_loaded) {
  header('Content-Type: text/html; charset=UTF-8');
  header('X-Content-Type-Options: nosniff');
  echo "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>";
  echo "<title>" . h($page_title) . "</title>";
  echo "<link rel='stylesheet' href='/lib/css/ui.css'>";
  echo "<link rel='stylesheet' href='/lib/css/staff.css'>";
  echo "</head><body class='staff'><main class='site-main' id='main'><div class='container' style='padding:16px 0;'>";
  echo "<div style='padding:12px;border:1px solid rgba(239,68,68,.35);border-radius:12px;background:rgba(239,68,68,.08);'>";
  echo "<strong>Tools header failed to load.</strong><br>";
  echo "<span style='opacity:.85;'>This page is running in fallback mode (so it won’t 500).</span>";
  if (!empty($GLOBALS['__tools_header_error'])) {
    echo "<pre style='margin-top:10px;white-space:pre-wrap;'>" . h((string)$GLOBALS['__tools_header_error']) . "</pre>";
  }
  echo "</div>";
  echo "</div>";
}

/* Load registry */
$registry = (defined('APP_ROOT') ? rtrim((string)APP_ROOT, '/\\') : '') . '/private/functions/staff_tools_registry.php';
$tools = [];

$registry_ok = false;
if ($registry !== '' && is_file($registry)) {
  try {
    require_once $registry;
    if (function_exists('mk_staff_tools_registry')) {
      $tools = mk_staff_tools_registry();
      $registry_ok = is_array($tools);
    }
  } catch (Throwable $e) {
    $registry_ok = false;
    $GLOBALS['__tools_registry_error'] = $e->getMessage();
  }
}

$runBase = url_for('/staff/tools/run.php?tool=');

$badge = static function(string $label, string $tone = 'muted'): string {
  $map = [
    'ok'    => 'background:rgba(34,197,94,.14);border:1px solid rgba(34,197,94,.30);color:#14532d;',
    'warn'  => 'background:rgba(245,158,11,.14);border:1px solid rgba(245,158,11,.32);color:#7c2d12;',
    'bad'   => 'background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.30);color:#7f1d1d;',
    'muted' => 'background:rgba(0,0,0,.05);border:1px solid rgba(0,0,0,.12);color:rgba(0,0,0,.70);',
  ];
  $css = $map[$tone] ?? $map['muted'];
  return '<span style="display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;font-weight:900;font-size:.78rem;letter-spacing:.04em;' . $css . '">' . h($label) . '</span>';
};

/* Group tools */
$groups = [];
if (is_array($tools)) {
  foreach ($tools as $key => $meta) {
    if (!is_string($key) || $key === '' || !is_array($meta)) continue;
    $group = isset($meta['group']) && is_string($meta['group']) && trim($meta['group']) !== '' ? trim($meta['group']) : 'Tools';
    if (!isset($groups[$group])) $groups[$group] = [];
    $groups[$group][$key] = $meta;
  }
}

echo '<section class="mk-hero" style="margin-top:14px;">';
echo '  <div class="mk-hero__bar" aria-hidden="true"></div>';
echo '  <div class="mk-hero__inner">';
echo '    <h1 class="mk-hero__title">Staff Tools</h1>';
echo '    <p class="mk-hero__subtitle">' . h($page_desc) . '</p>';
echo '    <div style="margin-top:10px; display:flex; gap:10px; flex-wrap:wrap;">';
echo        $badge('Header: ' . ($header_loaded ? 'OK' : 'FALLBACK'), $header_loaded ? 'ok' : 'warn');
echo        $badge('Registry: ' . ($registry_ok ? 'OK' : 'PROBLEM'), $registry_ok ? 'ok' : 'bad');
echo        $badge('UTC: ' . gmdate('Y-m-d H:i:s'), 'muted');
echo '    </div>';
echo '  </div>';
echo '</section>';

if (!$registry_ok) {
  echo '<section class="mk-card" style="padding:14px; margin-top:14px;">';
  echo '<p class="mk-muted" style="margin:0;"><strong>Registry problem.</strong><br>File: <code>' . h($registry) . '</code></p>';
  if (!empty($GLOBALS['__tools_registry_error'])) {
    echo '<pre style="margin-top:12px;white-space:pre-wrap;word-break:break-word;">' . h((string)$GLOBALS['__tools_registry_error']) . '</pre>';
  }
  echo '</section>';
} elseif (!$groups) {
  echo '<section class="mk-card" style="padding:14px; margin-top:14px;">';
  echo '<p class="mk-muted" style="margin:0;">No tools available. Registry returned an empty set.</p>';
  echo '</section>';
} else {
  echo '<section style="margin-top:16px; display:grid; gap:18px;">';

  foreach ($groups as $groupName => $items) {
    echo '<div>';
    echo '<div style="display:flex; align-items:baseline; justify-content:space-between; gap:10px; flex-wrap:wrap;">';
    echo '<h2 style="margin:0; font-size:1.05rem; font-weight:900;">' . h($groupName) . '</h2>';
    echo '<div class="mk-muted" style="font-size:.92rem;">' . h((string)count($items)) . ' tool(s)</div>';
    echo '</div>';

    echo '<div class="mk-grid" style="margin-top:10px; display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px;">';

    foreach ($items as $key => $meta) {
      $title = isset($meta['title']) ? (string)$meta['title'] : (string)$key;
      $desc  = isset($meta['desc'])  ? (string)$meta['desc']  : '';
      $minRole = isset($meta['min_role']) ? strtolower(trim((string)$meta['min_role'])) : 'admin';
      $href = $runBase . rawurlencode((string)$key);

      echo '<article class="mk-card" style="padding:14px;">';
      echo '  <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">';
      echo      $badge($minRole === 'owner' ? 'OWNER' : 'ADMIN', $minRole === 'owner' ? 'warn' : 'muted');
      echo      $badge('RUN', 'ok');
      echo '  </div>';
      echo '  <h3 style="margin:10px 0 6px; font-size:1.05rem; font-weight:900;">' . h($title) . '</h3>';
      echo '  <p class="mk-muted" style="margin:0;">' . h($desc) . '</p>';
      echo '  <div style="margin-top:12px;">';
      echo '    <a class="btn" href="' . h($href) . '">Run</a>';
      echo '  </div>';
      echo '</article>';
    }

    echo '</div>';
    echo '</div>';
  }

  echo '</section>';
}

/* Footer */
if (function_exists('mk_require_shared')) {
  try { mk_require_shared('staff_footer.php'); return; } catch (Throwable $e) {}
}
echo "</main></body></html>";
