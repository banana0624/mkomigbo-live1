if (!function_exists('pf__badge_kind')) {
  function pf__badge_kind(array $a): string {
    $k = (string)($a['kind'] ?? '');
    $m = (string)($a['mime_type'] ?? '');
    if ($k !== '') return strtoupper($k);
    if (str_starts_with($m, 'image/')) return 'IMAGE';
    if (str_starts_with($m, 'video/')) return 'VIDEO';
    if (str_starts_with($m, 'audio/')) return 'AUDIO';
    if ($m === 'application/pdf') return 'PDF';
    return 'FILE';
  }
}
if (!function_exists('pf__human_bytes')) {
  function pf__human_bytes(int $bytes): string {
    if ($bytes < 1024) return $bytes . ' B';
    $units = ['KB','MB','GB','TB'];
    $v = $bytes / 1024;
    foreach ($units as $u) {
      if ($v < 1024) return rtrim(rtrim(number_format($v, 2), '0'), '.') . ' ' . $u;
      $v /= 1024;
    }
    return rtrim(rtrim(number_format($v, 2), '0'), '.') . ' PB';
  }
}
if (!function_exists('pf__workflow_state_label')) {
  function pf__workflow_state_label(string $state): string {
    $state = strtolower(trim($state));
    return match ($state) {
      'draft' => 'Draft',
      'review', 'in_review' => 'In Review',
      'published' => 'Published',
      'archived' => 'Archived',
      default => ($state !== '' ? ucfirst(str_replace('_', ' ', $state)) : 'Draft'),
    };
  }
}
if (!function_exists('pf__workflow_state_class')) {
