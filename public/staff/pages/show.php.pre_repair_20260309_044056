}
if (!function_exists('staff_csrf_token')) {
  function staff_csrf_token(): string {
    mk_staff_session_start();

    foreach (['csrf_token', 'mk_csrf_token'] as $fn) {
      if (function_exists($fn)) {
        try {
          $v = (string)$fn();
          if ($v !== '') {
            $_SESSION['csrf_token'] = $v;
            $_SESSION['csrf'] = $v;
            $_SESSION['_token'] = $v;
            return $v;
          }
        } catch (Throwable $e) {
          // continue
        }
      }
    }

    foreach (['csrf_token', 'csrf', '_token'] as $k) {
      if (!empty($_SESSION[$k]) && is_string($_SESSION[$k])) {
        $v = (string)$_SESSION[$k];
        $_SESSION['csrf_token'] = $v;
        $_SESSION['csrf'] = $v;
        $_SESSION['_token'] = $v;
        return $v;
      }
    }

    $v = bin2hex(random_bytes(32));
    $_SESSION['csrf_token'] = $v;
    $_SESSION['csrf'] = $v;
    $_SESSION['_token'] = $v;
    return $v;
  }
}
