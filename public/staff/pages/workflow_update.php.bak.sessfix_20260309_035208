<?php
declare(strict_types=1);

require_once __DIR__ . '/../../_init.php';
auth_require_role('staff');

if (function_exists('mk__session_start')) {
  mk__session_start();
} elseif (session_status() !== PHP_SESSION_ACTIVE) {
  @session_start();
}

if (!function_exists('staff_redirect')) {
  function staff_redirect(string $location, int $code = 302): void {
    $location = str_replace(["\r", "\n"], '', $location);
    header('Location: ' . $location, true, $code);
    exit;
  }
}
if (!function_exists('staff_safe_return_url')) {
  function staff_safe_return_url(string $raw, string $default): string {
    $raw = trim($raw);
    if ($raw === '') return $default;
    $raw = rawurldecode($raw);
    if ($raw === '' || $raw[0] !== '/') return $default;
    if (preg_match('~^//~', $raw)) return $default;
    if (preg_match('~^[a-z]+:~i', $raw)) return $default;
    if (strpos($raw, '/staff/') !== 0) return $default;
    return $raw;
  }
}
if (!function_exists('pf__flash_set')) {
  function pf__flash_set(string $key, string $msg): void {
    if (function_exists('mk__session_start')) {
      mk__session_start();
    } elseif (session_status() !== PHP_SESSION_ACTIVE) {
      @session_start();
    }
    if (!isset($_SESSION['flash']) || !is_array($_SESSION['flash'])) {
      $_SESSION['flash'] = [];
    }
    $_SESSION['flash'][$key] = $msg;
  }
}
if (!function_exists('pf__column_exists')) {
  function pf__column_exists(PDO $pdo, string $table, string $column): bool {
    static $cache = [];
    $key = strtolower($table . '.' . $column);
    if (array_key_exists($key, $cache)) return (bool)$cache[$key];

    try {
      $st = $pdo->prepare("
        SELECT 1
        FROM information_schema.COLUMNS
        WHERE TABLE_SCHEMA = DATABASE()
          AND TABLE_NAME = ?
          AND COLUMN_NAME = ?
        LIMIT 1
      ");
      $st->execute([$table, $column]);
      $cache[$key] = (bool)$st->fetchColumn();
    } catch (Throwable $e) {
      $cache[$key] = false;
    }

    return (bool)$cache[$key];
  }
}
if (!function_exists('pf__verify_csrf')) {
  function pf__verify_csrf(): bool {
    if (function_exists('mk__session_start')) {
      mk__session_start();
    } elseif (session_status() !== PHP_SESSION_ACTIVE) {
      @session_start();
    }

    $postedCandidates = [
      (string)($_POST['csrf_token'] ?? ''),
      (string)($_POST['csrf'] ?? ''),
      (string)($_POST['_token'] ?? ''),
    ];
    $postedCandidates = array_values(array_filter($postedCandidates, static fn($v) => $v !== ''));
    if (!$postedCandidates) return false;

    foreach (['csrf_verify', 'mk_csrf_verify', 'csrf_check'] as $fn) {
      if (function_exists($fn)) {
        foreach ($postedCandidates as $posted) {
          try {
            if ($fn($posted) === true) return true;
          } catch (Throwable $e) {
            // continue
          }
        }
      }
    }

    $sessionCandidates = [];
    foreach (['csrf_token', 'csrf', '_token'] as $k) {
      if (!empty($_SESSION[$k]) && is_string($_SESSION[$k])) {
        $sessionCandidates[] = (string)$_SESSION[$k];
      }
    }
    $sessionCandidates = array_values(array_unique(array_filter($sessionCandidates, static fn($v) => $v !== '')));
    if (!$sessionCandidates) return false;

    foreach ($postedCandidates as $posted) {
      foreach ($sessionCandidates as $sess) {
        if (hash_equals($sess, $posted)) {
          return true;
        }
      }
    }

    return false;
  }
}
if (!function_exists('pf__normalize_workflow_action')) {
  function pf__normalize_workflow_action(string $action): string {
    $action = strtolower(trim($action));
    return match ($action) {
      'save_draft', 'draft' => 'save_draft',
      'mark_review', 'review', 'in_review' => 'mark_review',
      'publish', 'published' => 'publish',
      'unpublish', 'draft_again' => 'unpublish',
      default => $action,
    };
  }
}

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
  http_response_code(405);
  echo "Method not allowed.";
  exit;
}

$id = (int)($_POST['id'] ?? 0);
$return = staff_safe_return_url((string)($_POST['return'] ?? ''), '/staff/subjects/pgs/index.php');
$action = pf__normalize_workflow_action((string)($_POST['action'] ?? ''));
$note = trim((string)($_POST['workflow_note'] ?? ''));

if ($id <= 0) {
  pf__flash_set('error', 'Invalid page id.');
  staff_redirect($return);
}

if (!pf__verify_csrf()) {
  $sep = (strpos($return, '?') !== false) ? '&' : '?';
  pf__flash_set('error', 'Security check failed. Please retry.');
  staff_redirect($return . $sep . 'wf=csrf');
}

$pdo = (function_exists('db') && db() instanceof PDO) ? db() : null;
if (!$pdo instanceof PDO) {
  pf__flash_set('error', 'Database handle not available.');
  staff_redirect($return);
}

$allowed = ['save_draft', 'mark_review', 'publish', 'unpublish'];
if (!in_array($action, $allowed, true)) {
  pf__flash_set('error', 'Invalid workflow action.');
  staff_redirect($return);
}

$sets = [];
$params = [':id' => $id];

$hasWorkflowState = pf__column_exists($pdo, 'pages', 'workflow_state');
$hasWorkflowNote  = pf__column_exists($pdo, 'pages', 'workflow_note');
$hasPublishedAt   = pf__column_exists($pdo, 'pages', 'published_at');
$hasIsPublic      = pf__column_exists($pdo, 'pages', 'is_public');
$hasUpdatedAt     = pf__column_exists($pdo, 'pages', 'updated_at');

switch ($action) {
  case 'save_draft':
    if ($hasWorkflowState) $sets[] = "workflow_state = 'draft'";
    if ($hasIsPublic) $sets[] = "is_public = 0";
    if ($hasPublishedAt) $sets[] = "published_at = NULL";
    $success = 'Page saved as draft.';
    break;

  case 'mark_review':
    if ($hasWorkflowState) $sets[] = "workflow_state = 'review'";
    $success = 'Page moved to review.';
    break;

  case 'publish':
    if ($hasWorkflowState) $sets[] = "workflow_state = 'published'";
    if ($hasIsPublic) $sets[] = "is_public = 1";
    if ($hasPublishedAt) $sets[] = "published_at = NOW()";
    $success = 'Page published.';
    break;

  case 'unpublish':
    if ($hasWorkflowState) $sets[] = "workflow_state = 'draft'";
    if ($hasIsPublic) $sets[] = "is_public = 0";
    if ($hasPublishedAt) $sets[] = "published_at = NULL";
    $success = 'Page unpublished.';
    break;

  default:
    $success = 'Workflow updated.';
    break;
}

if ($hasWorkflowNote) {
  $sets[] = "workflow_note = :workflow_note";
  $params[':workflow_note'] = $note;
}

if ($hasUpdatedAt) {
  $sets[] = "updated_at = NOW()";
}

if (!$sets) {
  pf__flash_set('error', 'No compatible workflow columns exist on pages.');
  staff_redirect($return);
}

$sql = "UPDATE pages SET " . implode(', ', $sets) . " WHERE id = :id LIMIT 1";

try {
  $st = $pdo->prepare($sql);
  $st->execute($params);

  if (function_exists('mk_staff_audit_log')) {
    try {
      mk_staff_audit_log('page_workflow_update', [
        'page_id' => $id,
        'action' => $action,
      ]);
    } catch (Throwable $e) {
      // ignore audit failure
    }
  }

  pf__flash_set('notice', $success);
} catch (Throwable $e) {
  pf__flash_set('error', 'Workflow update failed.');
}

staff_redirect($return);