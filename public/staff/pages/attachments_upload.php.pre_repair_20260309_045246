<?php
declare(strict_types=1);

require_once __DIR__ . '/../../_init.php';

mk_require_staff_login();

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

mk_staff_session_start();

$method = strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET'));
if ($method !== 'POST') {
  http_response_code(405);
  header('Allow: POST');
  exit;
}

if (!function_exists('staff_safe_return_url')) {
  function staff_safe_return_url(string $raw, string $default): string {
    $raw = trim($raw);
    if ($raw === '') return $default;
    $raw = rawurldecode($raw);
    if ($raw === '' || $raw[0] !== '/') return $default;
    if (preg_match('~^//~', $raw)) return $default;
    if (preg_match('~^[a-z]+:~i', $raw)) return $default;
    if (strpos($raw, '/staff/') !== 0) return $default;
    return $raw;
  }
}
if (!function_exists('staff_redirect')) {
  function staff_redirect(string $location, int $code = 302): void {
    $location = str_replace(["\r","\n"], '', $location);
    header('Location: ' . $location, true, $code);
    exit;
  }
}
if (!function_exists('staff_pdo')) {
  function staff_pdo(): ?PDO {
    return (function_exists('db') && db() instanceof PDO) ? db() : null;
  }
}
if (!function_exists('staff_csrf_verify')) {
  function staff_csrf_verify(string $token): bool {
    mk_staff_session_start();
    if ($token === '') return false;

    foreach (['csrf_verify', 'mk_csrf_verify', 'csrf_check'] as $fn) {
      if (function_exists($fn)) {
        try {
          if ($fn($token) === true) return true;
        } catch (Throwable $e) {
          // continue
        }
      }
    }

    $sessionCandidates = [];
    foreach (['csrf_token', 'csrf', '_token'] as $k) {
      if (!empty($_SESSION[$k]) && is_string($_SESSION[$k])) {
        $sessionCandidates[] = (string)$_SESSION[$k];
      }
    }
    $sessionCandidates = array_values(array_unique(array_filter($sessionCandidates, static fn($v) => $v !== '')));

    foreach ($sessionCandidates as $sess) {
      if (hash_equals($sess, $token)) return true;
    }

    return false;
  }
}

$add_qs = static function(string $url, array $params): string {
  $url = str_replace(["\r","\n"], '', $url);
  $parts = parse_url($url);
  if (!is_array($parts)) {
    $glue = (strpos($url, '?') === false) ? '?' : '&';
    return $url . $glue . http_build_query($params);
  }

  $path = ($parts['path'] ?? '');
  $query = [];
  if (!empty($parts['query'])) parse_str((string)$parts['query'], $query);
  foreach ($params as $k => $v) $query[$k] = $v;

  $out = $path;
  $qs = http_build_query($query);
  if ($qs !== '') $out .= '?' . $qs;
  if (!empty($parts['fragment'])) $out .= '#' . $parts['fragment'];
  return $out;
};

$return = staff_safe_return_url((string)($_POST['return'] ?? ''), '/staff/subjects/pgs/index.php');

$go = static function (string $return, string $code, string $detail = '') use ($add_qs): never {
  $params = ['attach' => $code];
  $detail = trim($detail);
  if ($detail !== '') {
    $detail = preg_replace('/[\x00-\x1F\x7F]/u', ' ', $detail) ?? $detail;
    $detail = trim(preg_replace('/\s+/u', ' ', $detail) ?? $detail);
    if (function_exists('mb_substr')) $detail = (string)mb_substr($detail, 0, 900, 'UTF-8');
    else $detail = substr($detail, 0, 900);
    $params['attach_detail'] = $detail;
  }
  $target = $add_qs($return, $params);
  if (function_exists('url_for')) $target = (string)url_for($target);
  staff_redirect($target, 303);
};

$staffId = (int)($_SESSION['staff_user_id'] ?? 0);
if ($staffId < 1) {
  $login = function_exists('url_for')
    ? (string)url_for('/staff/login.php?notice=login')
    : '/staff/login.php?notice=login';
  $login = str_replace(["\r","\n"], '', $login);
  header('Location: ' . $login, true, 302);
  exit;
}

$token = (string)($_POST['csrf_token'] ?? ($_POST['csrf'] ?? ($_POST['_token'] ?? '')));
if (!staff_csrf_verify($token)) {
  $go($return, 'csrf');
}

$pageId = (int)($_POST['page_id'] ?? 0);
if ($pageId < 1) {
  $go($return, 'invalid');
}

$cl = (int)($_SERVER['CONTENT_LENGTH'] ?? 0);
if ($cl > 0 && empty($_FILES)) {
  $go($return, 'too_large');
}

$files = $_FILES['attachments'] ?? null;
if (!is_array($files) || (!isset($files['name']) && !isset($files['tmp_name']))) {
  $go($return, 'nofile');
}

$pdo = staff_pdo();
if (!$pdo instanceof PDO) {
  $go($return, 'error');
}

if (!defined('PRIVATE_PATH') || !is_string(PRIVATE_PATH) || PRIVATE_PATH === '') {
  $go($return, 'error');
}
$fn = rtrim(PRIVATE_PATH, '/\\') . '/functions/page_attachments_upload.php';
if (!is_file($fn)) {
  $go($return, 'error');
}
require_once $fn;

if (!function_exists('mk_staff_upload_page_attachments')) {
  $go($return, 'error');
}

$PER_FILE_MAX = 10 * 1024 * 1024;
$BATCH_MAX    = 30 * 1024 * 1024;
$MAX_FILES    = 12;

$allowed_ext = [
  'jpg','jpeg','png','gif','webp','svg',
  'pdf','txt','md','csv','tsv','json','xml',
  'doc','docx','ppt','pptx','xls','xlsx',
  'mp3','wav','ogg','m4a','mp4','webm','mov'
];

$ext_group = static function(string $ext): string {
  $e = strtolower($ext);
  if (in_array($e, ['jpg','jpeg','png','gif','webp','svg'], true)) return 'image';
  if ($e === 'pdf') return 'pdf';
  if (in_array($e, ['mp3','wav','ogg','m4a'], true)) return 'audio';
  if (in_array($e, ['mp4','webm','mov'], true)) return 'video';
  if (in_array($e, ['txt','md','csv','tsv','json','xml','doc','docx','ppt','pptx','xls','xlsx'], true)) return 'doc';
  return 'other';
};

$mime_ok = static function(string $mime, string $ext): bool {
  $m = strtolower(trim($mime));
  $e = strtolower($ext);

  if ($m === '') return false;

  if ($m === 'application/octet-stream') {
    return in_array($e, ['pdf','doc','docx','ppt','pptx','xls','xlsx','csv','tsv','json','xml','txt','md'], true);
  }

  if (in_array($e, ['jpg','jpeg','png','gif','webp','svg'], true)) return str_starts_with($m, 'image/');
  if ($e === 'pdf') return ($m === 'application/pdf');
  if (in_array($e, ['mp3','wav','ogg','m4a'], true)) return str_starts_with($m, 'audio/');
  if (in_array($e, ['mp4','webm','mov'], true)) return str_starts_with($m, 'video/');

  if (in_array($e, ['txt','md','csv','tsv','json','xml'], true)) {
    return (str_starts_with($m, 'text/') || in_array($m, ['application/json','application/xml','text/xml'], true));
  }

  if (in_array($e, ['doc','docx','ppt','pptx','xls','xlsx'], true)) {
    return (
      str_contains($m, 'officedocument') ||
      str_contains($m, 'msword') ||
      str_contains($m, 'ms-excel') ||
      str_contains($m, 'ms-powerpoint') ||
      in_array($m, ['application/zip'], true)
    );
  }

  return false;
};

$safe_name = static function(string $name): string {
  $name = trim($name);
  $name = preg_replace('/[\x00-\x1F\x7F]/u', '', $name) ?? $name;
  $name = str_replace(["\r","\n"], '', $name);
  $name = basename($name);
  if ($name === '') return 'file';
  if (function_exists('mb_substr')) $name = (string)mb_substr($name, 0, 180, 'UTF-8');
  else $name = substr($name, 0, 180);
  return $name;
};

$names = $files['name'] ?? [];
$tmp   = $files['tmp_name'] ?? [];
$size  = $files['size'] ?? [];
$err   = $files['error'] ?? [];
$type  = $files['type'] ?? [];

if (!is_array($names)) $names = [$names];
if (!is_array($tmp))   $tmp   = [$tmp];
if (!is_array($size))  $size  = [$size];
if (!is_array($err))   $err   = [$err];
if (!is_array($type))  $type  = [$type];

$total = 0;
$kept = [];
$reasons = [];

$finfo = null;
try {
  if (class_exists('finfo')) $finfo = new finfo(FILEINFO_MIME_TYPE);
} catch (Throwable $e) {
  $finfo = null;
}

$count = min(count($names), count($tmp), count($size), count($err));
if ($count < 1) $go($return, 'nofile');

if ($count > $MAX_FILES) {
  $reasons[] = "Too many files (max {$MAX_FILES}).";
  $count = $MAX_FILES;
}

for ($i = 0; $i < $count; $i++) {
  $orig = $safe_name((string)($names[$i] ?? 'file'));
  $e = (int)($err[$i] ?? UPLOAD_ERR_NO_FILE);

  if ($e === UPLOAD_ERR_NO_FILE) {
    $reasons[] = "{$orig}: no file.";
    continue;
  }
  if ($e !== UPLOAD_ERR_OK) {
    $map = [
      UPLOAD_ERR_INI_SIZE   => 'file too large (server limit)',
      UPLOAD_ERR_FORM_SIZE  => 'file too large (form limit)',
      UPLOAD_ERR_PARTIAL    => 'partial upload',
      UPLOAD_ERR_NO_TMP_DIR => 'missing temp dir',
      UPLOAD_ERR_CANT_WRITE => 'disk write failed',
      UPLOAD_ERR_EXTENSION  => 'blocked by PHP extension',
    ];
    $reasons[] = "{$orig}: " . ($map[$e] ?? "upload error ({$e})") . ".";
    continue;
  }

  $tmpPath = (string)($tmp[$i] ?? '');
  $sz = (int)($size[$i] ?? 0);

  if ($tmpPath === '' || !is_uploaded_file($tmpPath)) {
    $reasons[] = "{$orig}: invalid temp upload.";
    continue;
  }

  if ($sz <= 0) {
    $reasons[] = "{$orig}: empty file.";
    continue;
  }

  if ($sz > $PER_FILE_MAX) {
    $reasons[] = "{$orig}: exceeds per-file limit (" . round($PER_FILE_MAX/1048576, 1) . "MB).";
    continue;
  }

  $total += $sz;
  if ($total > $BATCH_MAX) {
    $reasons[] = "{$orig}: batch total exceeds limit (" . round($BATCH_MAX/1048576, 1) . "MB).";
    $total -= $sz;
    continue;
  }

  $ext = strtolower(pathinfo($orig, PATHINFO_EXTENSION));
  if ($ext === '' || !in_array($ext, $allowed_ext, true)) {
    $reasons[] = "{$orig}: file type not allowed.";
    continue;
  }

  $mime = '';
  try {
    if ($finfo instanceof finfo) $mime = (string)$finfo->file($tmpPath);
  } catch (Throwable $e2) { $mime = ''; }

  if ($mime === '') $mime = (string)($type[$i] ?? '');

  if (!$mime_ok($mime, $ext)) {
    $reasons[] = "{$orig}: MIME mismatch ({$mime}).";
    continue;
  }

  if ($ext_group($ext) === 'image' && $ext !== 'svg') {
    $imgOk = false;
    try { $imgOk = @getimagesize($tmpPath) !== false; } catch (Throwable $e3) { $imgOk = false; }
    if (!$imgOk) {
      $reasons[] = "{$orig}: invalid image file.";
      continue;
    }
  }

  $kept[] = $i;
}

if (empty($kept)) {
  $detail = $reasons ? implode(' | ', $reasons) : 'No valid files.';
  $go($return, 'invalid', $detail);
}

$filtered = [
  'name'     => [],
  'type'     => [],
  'tmp_name' => [],
  'error'    => [],
  'size'     => [],
];

foreach ($kept as $i) {
  $filtered['name'][]     = (string)($names[$i] ?? '');
  $filtered['type'][]     = (string)($type[$i] ?? '');
  $filtered['tmp_name'][] = (string)($tmp[$i] ?? '');
  $filtered['error'][]    = (int)($err[$i] ?? UPLOAD_ERR_OK);
  $filtered['size'][]     = (int)($size[$i] ?? 0);
}

try {
  $res = mk_staff_upload_page_attachments($pdo, $pageId, $staffId, $filtered);

  $notice = 'sent';
  if (!is_array($res) || empty($res['ok'])) $notice = 'error';
  if (!empty($reasons)) $notice = 'partial';
  if (is_array($res) && !empty($res['errors'])) $notice = 'partial';

  $detail = '';
  if ($notice === 'partial') {
    $parts = [];
    if (!empty($reasons)) $parts[] = implode(' | ', $reasons);
    if (is_array($res) && !empty($res['errors'])) {
      $eng = $res['errors'];
      if (is_array($eng)) $parts[] = 'Engine: ' . implode(' | ', array_map('strval', array_slice($eng, 0, 6)));
      else $parts[] = 'Engine: ' . (string)$eng;
    }
    $detail = implode(' | ', $parts);
  }

  $go($return, $notice, $detail);

} catch (Throwable $e) {
  $go($return, 'error');
}