<?php
declare(strict_types=1);

/**
 * /public/staff/login.php
 * Staff login (canonical).
 *
 * Goals:
 * - Zero accidental output before session/headers (buffer first)
 * - Uses canonical auth helpers: auth_login()
 * - Correct audit behavior:
 *   - NO audit spam on GET
 *   - Audits are emitted by auth.php on real outcomes (ok/fail/exception)
 * - Secure session cookie params (HTTPS-aware, samesite Lax)
 * - Safe internal return handling (prevents open redirect)
 * - Optional "loggedout=1" banner
 */

if (!ob_get_level()) { @ob_start(); }

@ini_set('display_errors', '0');
@ini_set('display_startup_errors', '0');
error_reporting(E_ALL & ~E_NOTICE & ~E_WARNING & ~E_DEPRECATED);

require_once __DIR__ . '/../_init.php';

////////////////////////////////////////////////////////////
// Helpers
////////////////////////////////////////////////////////////
if (!function_exists('h')) {
  function h(string $v): string { return htmlspecialchars($v, ENT_QUOTES, 'UTF-8'); }
}

function mk__is_post(): bool {
  return (($_SERVER['REQUEST_METHOD'] ?? '') === 'POST');
}

function mk__is_https_req(): bool {
  if (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') return true;
  $p = $_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '';
  if (is_string($p) && strtolower($p) === 'https') return true;
  $ssl = $_SERVER['HTTP_X_FORWARDED_SSL'] ?? '';
  if (is_string($ssl) && strtolower($ssl) === 'on') return true;
  return (($_SERVER['SERVER_PORT'] ?? '') === '443');
}

function mk__safe_internal_path(string $path): string {
  $path = str_replace(["\r","\n"], '', trim($path));
  if ($path === '') return '/staff/';

  // deny absolute URLs
  if (preg_match('~^https?://~i', $path)) return '/staff/';
  // normalize slashes
  $path = str_replace('\\', '/', $path);
  if ($path[0] !== '/') $path = '/' . $path;

  // only allow staff area returns
  if (strpos($path, '/staff/') !== 0) return '/staff/';

  return $path;
}

function mk__redirect(string $path): never {
  $path = str_replace(["\r","\n"], '', $path);
  header('Location: ' . $path, true, 302);
  exit;
}

////////////////////////////////////////////////////////////
// Load auth helpers (canonical)
////////////////////////////////////////////////////////////
if (!function_exists('auth_login') || !function_exists('mk_is_staff_logged_in') || !function_exists('mk__session_start')) {
  $auth = null;
  if (defined('PRIVATE_PATH') && is_string(PRIVATE_PATH) && PRIVATE_PATH !== '') {
    $auth = rtrim(PRIVATE_PATH, "/\\") . '/functions/auth.php';
  } elseif (defined('APP_ROOT') && is_string(APP_ROOT) && APP_ROOT !== '') {
    $auth = rtrim(APP_ROOT, "/\\") . '/private/functions/auth.php';
  }
  if ($auth && is_file($auth)) {
    require_once $auth;
  }
}

////////////////////////////////////////////////////////////
// Session start
////////////////////////////////////////////////////////////
if (function_exists('mk__session_start')) {
  mk__session_start();
} else {
  if (session_status() !== PHP_SESSION_ACTIVE) {
    if (!headers_sent()) {
      @session_set_cookie_params([
        'lifetime' => 0,
        'path'     => '/',
        'secure'   => mk__is_https_req(),
        'httponly' => true,
        'samesite' => 'Lax',
      ]);
    }
    @session_start();
  }
}

////////////////////////////////////////////////////////////
// No-cache (prevents cached forms / stale CSRF)
////////////////////////////////////////////////////////////
header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
header('Pragma: no-cache');
header('Expires: 0');

////////////////////////////////////////////////////////////
// CSRF (local to staff login form)
////////////////////////////////////////////////////////////
function mk__csrf_token(): string {
  if (empty($_SESSION['staff_csrf']) || !is_string($_SESSION['staff_csrf']) || strlen($_SESSION['staff_csrf']) < 20) {
    $_SESSION['staff_csrf'] = bin2hex(random_bytes(32));
  }
  return (string)$_SESSION['staff_csrf'];
}
function mk__csrf_valid(?string $token): bool {
  if (!is_string($token) || $token === '') return false;
  $sess = $_SESSION['staff_csrf'] ?? '';
  if (!is_string($sess) || $sess === '') return false;
  return hash_equals($sess, $token);
}

////////////////////////////////////////////////////////////
// Return URL (safe)
////////////////////////////////////////////////////////////
$return = '';
if (isset($_GET['return']) && is_string($_GET['return'])) {
  $return = mk__safe_internal_path($_GET['return']);
}
if ($return === '') $return = '/staff/';

////////////////////////////////////////////////////////////
// If already logged in
////////////////////////////////////////////////////////////
if (function_exists('mk_is_staff_logged_in') && mk_is_staff_logged_in()) {
  mk__redirect($return);
}

////////////////////////////////////////////////////////////
// Handle login
////////////////////////////////////////////////////////////
$error = '';
$email = '';

$loggedout = (isset($_GET['loggedout']) && (string)$_GET['loggedout'] === '1');

if (mk__is_post()) {
  $email = trim((string)($_POST['email'] ?? ''));
  $pass  = (string)($_POST['password'] ?? '');
  $csrf  = (string)($_POST['csrf'] ?? '');

  // Allow POST return override, but keep it safe
  if (isset($_POST['return']) && is_string($_POST['return'])) {
    $return = mk__safe_internal_path((string)$_POST['return']);
  }

  if (!mk__csrf_valid($csrf)) {
    $error = 'Security validation failed. Please refresh and try again.';
  } elseif ($email === '' || $pass === '') {
    $error = 'Email and password are required.';
  } else {
    // Canonical login (auth.php will emit audit logs: success/failure/exception)
    if (function_exists('auth_login')) {
      $res = auth_login($email, $pass);
      if (!is_array($res) || empty($res['ok'])) {
        // keep error generic to avoid user enumeration
        $error = is_array($res) && !empty($res['error']) ? (string)$res['error'] : 'Login failed.';
      } else {
        // Success: rotate CSRF token to prevent replay of old form
        $_SESSION['staff_csrf'] = bin2hex(random_bytes(32));
        mk__redirect($return);
      }
    } else {
      $error = 'Login is not available (auth helpers missing).';
    }
  }
}

$csrf = mk__csrf_token();

?>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Staff Login</title>
<style>
  body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#f6f7f9;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;padding:18px}
  .card{background:#fff;padding:26px;border-radius:14px;box-shadow:0 8px 24px rgba(0,0,0,.10);width:360px;max-width:100%}
  h1{margin:0 0 8px 0;font-size:20px}
  .muted{color:#6b7280;font-size:13px;margin:0 0 12px 0;line-height:1.35}
  label{display:block;margin-top:12px;font-size:13px;color:#111827}
  input{width:100%;padding:10px;margin-top:6px;border:1px solid #cfd4dc;border-radius:10px;font-size:14px}
  button{margin-top:16px;width:100%;padding:11px 12px;background:#2563eb;border:none;color:#fff;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer}
  button:hover{filter:brightness(.98)}
  .error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:10px 12px;border-radius:12px;margin:10px 0 0 0;font-size:13px}
  .ok{background:#ecfdf5;border:1px solid #bbf7d0;color:#14532d;padding:10px 12px;border-radius:12px;margin:10px 0 0 0;font-size:13px}
  .row{margin-top:12px;display:flex;justify-content:space-between;gap:10px;align-items:center}
  .row a{color:#2563eb;text-decoration:none;font-size:13px}
  .row a:hover{text-decoration:underline}
</style>
</head>
<body>
  <div class="card">
    <h1>Staff Login</h1>
    <p class="muted">Authorized staff only. Your access is logged for security.</p>

    <?php if ($loggedout): ?>
      <div class="ok">You’ve been logged out.</div>
    <?php endif; ?>

    <?php if ($error !== ''): ?>
      <div class="error"><?=h($error)?></div>
    <?php endif; ?>

    <form method="post" autocomplete="off" novalidate>
      <input type="hidden" name="csrf" value="<?=h($csrf)?>">
      <input type="hidden" name="return" value="<?=h($return)?>">

      <label>Email</label>
      <input type="email" name="email" value="<?=h($email)?>" required>

      <label>Password</label>
      <input type="password" name="password" required>

      <button type="submit">Login</button>

      <div class="row">
        <a href="/staff/">Staff Home</a>
        <a href="/staff/logout.php">Force Logout</a>
      </div>
    </form>
  </div>
</body>
</html>