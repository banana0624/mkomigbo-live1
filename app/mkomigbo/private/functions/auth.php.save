<?php
declare(strict_types=1);

/**
 * Unified staff auth helpers
 * Single source of truth for:
 * - login
 * - current staff id
 * - session version validation
 * - require staff login
 * - logout
 */

if (!function_exists('mk__auth_log')) {
  function mk__auth_log(string $level, string $message, array $context = []): void {
    try {
      $line = '[staff-auth][' . strtoupper($level) . '] ' . $message;
      if (!empty($context)) {
        $json = json_encode($context, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
        if ($json !== false) {
          $line .= ' ' . $json;
        }
      }
      error_log($line);
    } catch (Throwable $e) {
      // swallow
    }
  }
}

if (!function_exists('mk_staff_session_start')) {
  function mk_staff_session_start(): void {
    if (function_exists('mk__session_start')) {
      mk__session_start();
      return;
    }

    if (session_status() !== PHP_SESSION_ACTIVE) {
      @session_start();
    }
  }
}

if (!function_exists('mk_staff_current_id')) {
  function mk_staff_current_id(): int {
    mk_staff_session_start();
    $uid = (int)($_SESSION['staff_user_id'] ?? 0);
    return ($uid > 0) ? $uid : 0;
  }
}

if (!function_exists('mk_staff_session_version_valid')) {
  function mk_staff_session_version_valid(?int $uid = null): bool {
    mk_staff_session_start();

    if ($uid === null) {
      $uid = (int)($_SESSION['staff_user_id'] ?? 0);
    }
    if ($uid <= 0) {
      return false;
    }

    $sessVer = (int)($_SESSION['staff_session_version'] ?? 0);
    if ($sessVer <= 0) {
      return false;
    }

    try {
      if (!function_exists('db')) {
        mk__auth_log('ERROR', 'db() missing during session_version validation.');
        return false;
      }

      $pdo = db();
      if (!$pdo instanceof PDO) {
        mk__auth_log('ERROR', 'db() did not return PDO during session_version validation.');
        return false;
      }

      $st = $pdo->prepare("
        SELECT session_version
        FROM staff_users
        WHERE id = ?
        LIMIT 1
      ");
      $st->execute([$uid]);
      $dbVer = (int)($st->fetchColumn() ?: 0);

      return ($dbVer > 0 && $dbVer === $sessVer);
    } catch (Throwable $e) {
      mk__auth_log('ERROR', 'session_version validation exception', [
        'uid' => $uid,
        'err' => $e->getMessage(),
      ]);
      return false;
    }
  }
}

if (!function_exists('mk_force_staff_logout_local')) {
  function mk_force_staff_logout_local(): void {
    mk_staff_session_start();

    $uid   = (int)($_SESSION['staff_user_id'] ?? 0);
    $email = (string)($_SESSION['staff_email'] ?? '');
    $roles = $_SESSION['staff_roles'] ?? [];

    try {
      if ($uid > 0 && function_exists('mk_staff_audit_log')) {
        mk_staff_audit_log('staff_session_invalidated', [
          'email' => $email,
          'roles' => is_array($roles) ? $roles : [],
        ], $uid);
      }
    } catch (Throwable $e) {
      // swallow
    }

    $_SESSION = [];

    if (ini_get('session.use_cookies')) {
      $p = session_get_cookie_params();
      setcookie(
        session_name(),
        '',
        time() - 42000,
        $p['path'] ?? '/',
        $p['domain'] ?? '',
        (bool)($p['secure'] ?? false),
        (bool)($p['httponly'] ?? true)
      );
    }

    if (session_status() === PHP_SESSION_ACTIVE) {
      @session_destroy();
    }
  }
}

if (!function_exists('mk_require_staff_login')) {
  function mk_require_staff_login(): void {
    mk_staff_session_start();

    $uid = (int)($_SESSION['staff_user_id'] ?? 0);
    if ($uid <= 0) {
      if (function_exists('mk_staff_audit_log')) {
        mk_staff_audit_log('staff_access_denied', ['reason' => 'not_logged_in'], 0);
      }
      header('Location: /staff/login.php', true, 302);
      exit;
    }

    if (!mk_staff_session_version_valid($uid)) {
      mk_force_staff_logout_local();
      header('Location: /staff/login.php?forced=1', true, 302);
      exit;
    }
  }
}

if (!function_exists('mk_staff_logout')) {
  function mk_staff_logout(): void {
    mk_staff_session_start();

    $uid   = (int)($_SESSION['staff_user_id'] ?? 0);
    $email = (string)($_SESSION['staff_email'] ?? '');
    $roles = $_SESSION['staff_roles'] ?? [];

    try {
      if ($uid > 0 && function_exists('mk_staff_audit_log')) {
        mk_staff_audit_log('staff_logout', [
          'email' => $email,
          'roles' => is_array($roles) ? $roles : [],
        ], $uid);
      }
    } catch (Throwable $e) {
      // swallow
    }

    $_SESSION = [];

    if (ini_get('session.use_cookies')) {
      $p = session_get_cookie_params();
      setcookie(
        session_name(),
        '',
        time() - 42000,
        $p['path'] ?? '/',
        $p['domain'] ?? '',
        (bool)($p['secure'] ?? false),
        (bool)($p['httponly'] ?? true)
      );
    }

    if (session_status() === PHP_SESSION_ACTIVE) {
      @session_destroy();
    }
  }
}

if (!function_exists('mk_attempt_staff_login')) {
  function mk_attempt_staff_login(string $email, string $password): array {
    $email = trim($email);
    $password = (string)$password;

    if ($email === '' || $password === '') {
      if (function_exists('mk_staff_audit_log')) {
        mk_staff_audit_log('staff_login_failed_missing_fields', ['staff_user_id' => 0]);
      }
      return ['ok' => false, 'id' => 0, 'error' => 'Email and password are required.'];
    }

    $email_norm = function_exists('mb_strtolower')
      ? mb_strtolower($email, 'UTF-8')
      : strtolower($email);
    $email_norm = trim($email_norm);

    $fail = 'Login failed. Confirm your email and password match staff_users.';
    $rk = function_exists('mk_rate_key') ? mk_rate_key($email_norm) : '';

    if ($rk !== '' && function_exists('mk_rate_limit_check')) {
      [$allowed, $retryAfter] = mk_rate_limit_check($rk, 8, 15 * 60);
      if (!$allowed) {
        if (function_exists('mk_staff_audit_log')) {
          mk_staff_audit_log('staff_login_rate_limited', ['staff_user_id' => 0]);
        }
        return ['ok' => false, 'id' => 0, 'error' => "Too many login attempts. Try again in about {$retryAfter} seconds."];
      }
    }

    if (!function_exists('db')) {
      return ['ok' => false, 'id' => 0, 'error' => 'DB helper db() not available.'];
    }

    try {
      $pdo = db();
      if (!$pdo instanceof PDO) {
        mk__auth_log('ERROR', 'Staff login: db() did not return PDO.');
        return ['ok' => false, 'id' => 0, 'error' => 'DB not available.'];
      }

      $st = $pdo->prepare("
        SELECT id, email, password_hash, is_active, session_version
        FROM staff_users
        WHERE LOWER(email) = LOWER(?)
        LIMIT 1
      ");
      $st->execute([$email_norm]);
      $u = $st->fetch(PDO::FETCH_ASSOC) ?: null;

      if (!$u) {
        if ($rk !== '' && function_exists('mk_rate_limit_hit')) {
          mk_rate_limit_hit($rk);
        }
        mk__auth_log('INFO', 'Staff login failed: email not found.', ['email' => $email_norm]);
        if (function_exists('mk_staff_audit_log')) {
          mk_staff_audit_log('staff_login_failed_email', [
            'email' => $email_norm,
            'staff_user_id' => 0,
          ]);
        }
        @usleep(150000);
        return ['ok' => false, 'id' => 0, 'error' => $fail];
      }

      $uid = (int)($u['id'] ?? 0);

      if ((int)($u['is_active'] ?? 0) !== 1) {
        if ($rk !== '' && function_exists('mk_rate_limit_hit')) {
          mk_rate_limit_hit($rk);
        }
        mk__auth_log('INFO', 'Staff login failed: account inactive.', ['id' => $uid]);
        if (function_exists('mk_staff_audit_log')) {
          mk_staff_audit_log('staff_login_failed_inactive', [
            'email' => (string)($u['email'] ?? $email_norm),
            'staff_user_id' => $uid,
          ]);
        }
        @usleep(150000);
        return ['ok' => false, 'id' => 0, 'error' => 'Account is disabled.'];
      }

      $hash = trim((string)($u['password_hash'] ?? ''));
      if ($hash === '' || strlen($hash) < 20) {
        if ($rk !== '' && function_exists('mk_rate_limit_hit')) {
          mk_rate_limit_hit($rk);
        }
        mk__auth_log('ERROR', 'Staff login failed: password_hash missing/short.', [
          'id' => $uid,
          'hash_len' => strlen($hash),
        ]);
        if (function_exists('mk_staff_audit_log')) {
          mk_staff_audit_log('staff_login_failed_hash_invalid', [
            'hash_len' => strlen($hash),
            'staff_user_id' => $uid,
          ]);
        }
        @usleep(150000);
        return ['ok' => false, 'id' => 0, 'error' => $fail];
      }

      if (!password_verify($password, $hash)) {
        if ($rk !== '' && function_exists('mk_rate_limit_hit')) {
          mk_rate_limit_hit($rk);
        }
        mk__auth_log('INFO', 'Staff login failed: bad password.', ['id' => $uid]);
        if (function_exists('mk_staff_audit_log')) {
          mk_staff_audit_log('staff_login_failed_password', [
            'email' => (string)($u['email'] ?? $email_norm),
            'staff_user_id' => $uid,
          ]);
        }
        @usleep(150000);
        return ['ok' => false, 'id' => 0, 'error' => $fail];
      }

      if (password_needs_rehash($hash, PASSWORD_DEFAULT)) {
        try {
          $new = password_hash($password, PASSWORD_DEFAULT);
          if ($new) {
            $up = $pdo->prepare("UPDATE staff_users SET password_hash = ? WHERE id = ? LIMIT 1");
            $up->execute([$new, $uid]);
            if (function_exists('mk_staff_audit_log')) {
              mk_staff_audit_log('staff_login_rehash_ok', ['staff_user_id' => $uid]);
            }
          }
        } catch (Throwable $e) {
          mk__auth_log('WARN', 'Staff login: rehash update failed.', [
            'id' => $uid,
            'err' => $e->getMessage(),
          ]);
          if (function_exists('mk_staff_audit_log')) {
            mk_staff_audit_log('staff_login_rehash_failed', [
              'err' => $e->getMessage(),
              'staff_user_id' => $uid,
            ]);
          }
        }
      }

      mk_staff_session_start();
      @session_regenerate_id(true);

      $_SESSION['staff_user_id'] = $uid;
      $_SESSION['staff_email'] = (string)($u['email'] ?? $email_norm);
      $_SESSION['staff_session_version'] = (int)($u['session_version'] ?? 1);

      if (function_exists('mk_staff_roles_load')) {
        $roles = mk_staff_roles_load($uid, true);
        $_SESSION['staff_roles'] = $roles;
        $_SESSION['staff_roles_ts'] = time();
      } else {
        $roles = [];
      }

      if ($rk !== '') {
        try {
          $del = $pdo->prepare("DELETE FROM staff_login_rate_limits WHERE `key` = ?");
          $del->execute([$rk]);
        } catch (Throwable $e) {
          // swallow
        }
      }

      mk__auth_log('INFO', 'Staff login OK.', ['id' => $uid, 'roles' => $roles]);

      if (function_exists('mk_staff_audit_log')) {
        mk_staff_audit_log('staff_login_ok', [
          'email' => $_SESSION['staff_email'],
          'roles' => $roles,
          'staff_user_id' => $uid,
        ]);
      }

      return ['ok' => true, 'id' => $uid, 'error' => ''];
    } catch (Throwable $e) {
      mk__auth_log('ERROR', 'Staff login exception.', ['err' => $e->getMessage()]);
      if (function_exists('mk_staff_audit_log')) {
        mk_staff_audit_log('staff_login_exception', [
          'err' => $e->getMessage(),
          'staff_user_id' => 0,
        ]);
      }
      return ['ok' => false, 'id' => 0, 'error' => 'Login error.'];
    }
  }

}


