<?php
declare(strict_types=1);

/**
 * /private/functions/subjects_registry_helpers.php
 *
 * Canonical registry helpers for Subjects.
 *
 * CONTRACT:
 * - The canonical registry file is: /private/registry/subjects_register.php
 * - The canonical list function is: mk_subjects_registry_sorted()
 *
 * This file provides:
 * - mk_subjects_registry_sorted() (if not already defined by registry)
 * - mk_registry_subjects_by_slug()
 * - mk_subject_ui_code() + mk_page_ui_code()
 * - mk_subjects_apply_registry_order() (reorder DB rows by registry nav_order)
 * - mk_subjects_maybe_apply_registry_order() (use DB ordering only if sufficiently populated)
 * - mk_subject_meta_fallback() wrapper (if needed)
 */

if (defined('MK_SUBJECTS_REGISTRY_HELPERS_LOADED')) { return; }
define('MK_SUBJECTS_REGISTRY_HELPERS_LOADED', true);

/* ---------------------------------------------------------
   Load canonical registry (exact path, deterministic)
--------------------------------------------------------- */
if (!function_exists('mk__require_subjects_registry')) {
  function mk__require_subjects_registry(): void
  {
    static $loaded = false;
    if ($loaded) return;

    $file = '';

    if (defined('APP_ROOT')) {
      $cand = rtrim((string)APP_ROOT, "/\\") . '/private/registry/subjects_register.php';
      if (is_file($cand)) $file = $cand;
    }

    if ($file === '' && defined('PRIVATE_PATH')) {
      $cand = rtrim((string)PRIVATE_PATH, "/\\") . '/registry/subjects_register.php';
      if (is_file($cand)) $file = $cand;
    }

    // Relative fallback for safety
    if ($file === '') {
      $cand = __DIR__ . '/../registry/subjects_register.php';
      if (is_file($cand)) $file = $cand;
    }

    if ($file !== '') {
      /** @noinspection PhpIncludeInspection */
      require_once $file;
    }

    $loaded = true;
  }
}

/* ---------------------------------------------------------
   Basic helpers
--------------------------------------------------------- */
if (!function_exists('mk_subject_ui_code')) {
  function mk_subject_ui_code(int $subjectId): string
  {
    if ($subjectId <= 0) return '';
    return 'S' . str_pad((string)$subjectId, 2, '0', STR_PAD_LEFT);
  }
}

if (!function_exists('mk_page_ui_code')) {
  function mk_page_ui_code(int $subjectId, int $pageId): string
  {
    if ($subjectId <= 0 || $pageId <= 0) return '';
    return mk_subject_ui_code($subjectId) . '-P' . str_pad((string)$pageId, 2, '0', STR_PAD_LEFT);
  }
}

/* ---------------------------------------------------------
   Registry accessors
--------------------------------------------------------- */
if (!function_exists('mk_subjects_registry_all')) {
  /**
   * @return array<int,array<string,mixed>> list (canonical order not guaranteed)
   */
  function mk_subjects_registry_all(): array
  {
    mk__require_subjects_registry();

    // Prefer the registry’s canonical function
    if (function_exists('subjects_all_registry')) {
      $r = subjects_all_registry();
      if (is_array($r)) {
        $rows = array_values(array_filter($r, static fn($x) => is_array($x)));
        return $rows;
      }
    }

    return [];
  }
}

if (!function_exists('mk_subjects_registry_sorted')) {
  /**
   * @return array<int,array<string,mixed>> list in canonical order (id/nav_order)
   */
  function mk_subjects_registry_sorted(): array
  {
    mk__require_subjects_registry();

    if (function_exists('mk_subjects_registry_sorted')) {
      // If the registry defined it, use it.
      // (This guard is here only for completeness; in this file we only define it once.)
    }

    if (function_exists('subjects_sorted_registry')) {
      $r = subjects_sorted_registry();
      if (is_array($r)) return array_values(array_filter($r, static fn($x) => is_array($x)));
    }

    // Fallback: sort by id
    $rows = mk_subjects_registry_all();
    $rows = array_values(array_filter($rows, static function ($s): bool {
      return is_array($s) && isset($s['id']) && is_numeric($s['id']) && isset($s['slug']);
    }));

    usort($rows, static fn($a, $b) => (int)$a['id'] <=> (int)$b['id']);
    return $rows;
  }
}

if (!function_exists('mk_registry_subjects_by_slug')) {
  /**
   * @return array<string,array<string,mixed>>
   */
  function mk_registry_subjects_by_slug(): array
  {
    $by = [];
    foreach (mk_subjects_registry_sorted() as $row) {
      $slug = strtolower(trim((string)($row['slug'] ?? '')));
      if ($slug === '') continue;
      $by[$slug] = $row;
    }
    return $by;
  }
}

/* ---------------------------------------------------------
   Apply registry ordering to DB rows
--------------------------------------------------------- */
if (!function_exists('mk_subjects_apply_registry_order')) {
  /**
   * @param array<int,array<string,mixed>> $subjects DB rows
   * @return array<int,array<string,mixed>>
   */
  function mk_subjects_apply_registry_order(array $subjects): array
  {
    if (!$subjects) return $subjects;

    $regBySlug = mk_registry_subjects_by_slug();
    if (!$regBySlug) return $subjects;

    usort($subjects, static function ($a, $b) use ($regBySlug): int {
      $sa = strtolower(trim((string)($a['slug'] ?? '')));
      $sb = strtolower(trim((string)($b['slug'] ?? '')));

      $ra = ($sa !== '' && isset($regBySlug[$sa])) ? $regBySlug[$sa] : null;
      $rb = ($sb !== '' && isset($regBySlug[$sb])) ? $regBySlug[$sb] : null;

      $oa = is_array($ra) ? (int)($ra['nav_order'] ?? $ra['id'] ?? PHP_INT_MAX) : PHP_INT_MAX;
      $ob = is_array($rb) ? (int)($rb['nav_order'] ?? $rb['id'] ?? PHP_INT_MAX) : PHP_INT_MAX;

      if ($oa !== $ob) return $oa <=> $ob;

      // Stable tie-breaker: registry id, then DB id
      $ia = is_array($ra) ? (int)($ra['id'] ?? PHP_INT_MAX) : PHP_INT_MAX;
      $ib = is_array($rb) ? (int)($rb['id'] ?? PHP_INT_MAX) : PHP_INT_MAX;
      if ($ia !== $ib) return $ia <=> $ib;

      return (int)($a['id'] ?? 0) <=> (int)($b['id'] ?? 0);
    });

    return $subjects;
  }
}

if (!function_exists('mk_subjects_maybe_apply_registry_order')) {
  /**
   * Trust DB nav_order only if it looks meaningfully populated; else enforce registry order.
   */
  function mk_subjects_maybe_apply_registry_order(PDO $pdo, array $subjects): array
  {
    if (!$subjects) return $subjects;

    $hasNav = false;
    if (function_exists('mk_has_column')) {
      try { $hasNav = (bool)mk_has_column($pdo, 'subjects', 'nav_order'); } catch (Throwable $e) { $hasNav = false; }
    }

    if (!$hasNav) return mk_subjects_apply_registry_order($subjects);

    $nonZero = 0;
    $total = 0;
    foreach ($subjects as $s) {
      $total++;
      $v = $s['nav_order'] ?? null;
      if ($v !== null && (int)$v > 0) $nonZero++;
    }

    if ($total > 0 && ($nonZero / $total) >= 0.6) {
      return $subjects; // DB ordering is likely deliberate
    }

    return mk_subjects_apply_registry_order($subjects);
  }
}

/* ---------------------------------------------------------
   SEO meta fallback wrapper (from registry if available)
--------------------------------------------------------- */
if (!function_exists('mk_subject_meta_fallback')) {
  function mk_subject_meta_fallback(string $slug): array
  {
    mk__require_subjects_registry();
    if (function_exists('mk_subject_meta_fallback')) {
      // already exists in registry file; this block won't run due to function_exists guard
    }
    return ['meta_description' => '', 'meta_keywords' => '', 'icon' => ''];
  }
}
