    foreach ($offender_strings as $needle) {
      if (strpos($content, $needle) !== false) {
        mk_add_finding($report, 'fail', 'PUBLIC_INIT_PATH_OFFENDER', 'Public endpoint references incorrect initialize path: ' . $needle, $file, ['rel' => $rel]);
        break;
      }
    }
  }

  // 4) Direct include of private assets from public endpoint without staff guard patterns (heuristic)
  if ($content !== '' && (strpos($content, '/private/') !== false || strpos($content, 'PRIVATE_PATH') !== false)) {
    $hasGuard = (strpos($content, 'require_staff_login') !== false)
             || (strpos($content, 'require_staff') !== false)
             || (strpos($content, 'mk_require_staff_login') !== false)
             || (strpos($content, 'require_staff_role') !== false)
             || (strpos($content, 'require_staff_admin') !== false);

    if (!$hasGuard && strpos($relLower, '/staff/') === false) {
      mk_add_finding($report, 'warn', 'PUBLIC_PRIVATE_INCLUDE_NO_GUARD', 'Public endpoint touches private code without an obvious staff/auth guard. Review.', $file, ['rel' => $rel]);
    }
  }

  // Optional lint (best effort)
