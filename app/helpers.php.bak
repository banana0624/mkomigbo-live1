<?php

declare(strict_types=1);

function mk_render_page(array $page): void
{
    $title = htmlspecialchars((string)($page['title'] ?? 'Mkomigbo'), ENT_QUOTES, 'UTF-8');
    $body  = $page['body'] ?? '';
    $slug  = (string)($page['slug'] ?? '');

    // For the homepage, render the full landing page
    if ($slug === 'home' || $body === '') {
        mk_render_homepage($page);
        return;
    }

    echo '<!DOCTYPE html>';
    echo '<html lang="en">';
    echo '<head>';
    echo '<meta charset="UTF-8">';
    echo '<meta name="viewport" content="width=device-width,initial-scale=1">';
    echo '<title>' . $title . ' – Mkomigbo</title>';
    echo '<link rel="stylesheet" href="/assets/css/ui.css">';
    echo '<link rel="stylesheet" href="/assets/css/public.css">';
    echo '</head>';
    echo '<body>';
    echo '<header class="site-header"><div class="container"><a class="brand" href="/"><img src="/assets/images/logos/mk-logo.png" alt="Mkomigbo" width="32" height="32" style="border-radius:8px;"><span class="brand__text"><span class="brand__title">Mkomigbo</span><span class="brand__sub">Knowledge Platform</span></span></a><nav class="nav"><a href="/subjects/">Subjects</a><a href="/platforms/">Platforms</a><a href="/contributors/">Contributors</a><a href="/igbo-calendar/">Calendar</a></nav></div></header>';
    echo '<main class="site-main"><div class="container">';
    echo '<h1>' . $title . '</h1>';
    echo $body;
    echo '</div></main>';
    echo '<footer style="margin-top:48px;padding:24px 0;border-top:1px solid var(--border);text-align:center;color:var(--muted);font-size:.9rem;"><div class="container">© ' . date('Y') . ' Mkomigbo · <a href="/staff/">Staff</a></div></footer>';
    echo '</body></html>';
}

function mk_render_homepage(array $page): void
{
    $sections = [
        ['href'=>'/subjects/',     'icon'=>'📚', 'title'=>'Subjects',      'desc'=>'19 topic areas covering Igbo history, culture, language, religion, and more.'],
        ['href'=>'/platforms/',    'icon'=>'🏛️',  'title'=>'Platforms',     'desc'=>'Communities, events, blogs, and engagement spaces for the Igbo world.'],
        ['href'=>'/contributors/', 'icon'=>'✍️',  'title'=>'Contributors',  'desc'=>'Meet the scholars, writers, and researchers who build this knowledge base.'],
        ['href'=>'/igbo-calendar/','icon'=>'📅', 'title'=>'Igbo Calendar',  'desc'=>'Traditional Igbo calendar with cultural dates, seasons, and observances.'],
        ['href'=>'/subjects/history','icon'=>'🏺','title'=>'History',       'desc'=>'Timelines, migrations, kingdoms, and turning points of Igbo civilization.'],
        ['href'=>'/subjects/language1','icon'=>'🗣️','title'=>'Language',   'desc'=>'Igbo language systems, orthography, writing, and learning tracks.'],
        ['href'=>'/subjects/culture','icon'=>'🎭','title'=>'Culture',       'desc'=>'Arts, customs, festivals, clothing, and the values that define Igbo life.'],
        ['href'=>'/subjects/spirituality','icon'=>'🔮','title'=>'Esoterism','desc'=>'Cosmology, metaphysics, and spiritual practice in Igbo tradition.'],
    ];

    echo '<!DOCTYPE html>';
    echo '<html lang="en">';
    echo '<head>';
    echo '<meta charset="UTF-8">';
    echo '<meta name="viewport" content="width=device-width,initial-scale=1">';
    echo '<title>Mkomigbo – Igbo Knowledge Platform</title>';
    echo '<meta name="description" content="Mkomigbo is a comprehensive Igbo knowledge platform covering history, culture, language, spirituality, and more.">';
    echo '<link rel="stylesheet" href="/assets/css/ui.css">';
    echo '<link rel="stylesheet" href="/assets/css/public.css">';
    echo '<link rel="stylesheet" href="/assets/css/home.css">';
    echo '</head>';
    echo '<body>';

    // ── Header ──────────────────────────────────────────────
    echo '<header class="site-header">';
    echo '<div class="container" style="display:flex;align-items:center;justify-content:space-between;min-height:64px;gap:14px;">';
    echo '<a class="brand" href="/" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:inherit;">';
    echo '<img src="/assets/images/logos/mk-logo.png" alt="Mkomigbo Logo" width="36" height="36" style="border-radius:10px;">';
    echo '<span class="brand__text"><span class="brand__title" style="font-weight:900;font-size:1.08rem;">Mkomigbo</span><span class="brand__sub" style="font-size:.8rem;color:var(--muted);">Knowledge Platform</span></span>';
    echo '</a>';
    echo '<nav class="nav" style="display:flex;gap:6px;align-items:center;">';
    echo '<a href="/subjects/" style="padding:7px 12px;border-radius:10px;text-decoration:none;color:var(--muted);font-weight:600;font-size:.92rem;">Subjects</a>';
    echo '<a href="/platforms/" style="padding:7px 12px;border-radius:10px;text-decoration:none;color:var(--muted);font-weight:600;font-size:.92rem;">Platforms</a>';
    echo '<a href="/contributors/" style="padding:7px 12px;border-radius:10px;text-decoration:none;color:var(--muted);font-weight:600;font-size:.92rem;">Contributors</a>';
    echo '<a href="/awag/" style="padding:11px 20px;background:transparent;color:var(--fg);border:1px solid var(--border);border-radius:12px;text-decoration:none;font-weight:700;font-size:.95rem;">🌍 AWAG</a>';
  echo '<a href="/igbo-calendar/" style="padding:7px 12px;border-radius:10px;text-decoration:none;color:var(--muted);font-weight:600;font-size:.92rem;">Calendar</a>';
    echo '</nav>';
    echo '</div>';
    echo '</header>';

    // ── Main ────────────────────────────────────────────────
    echo '<main class="site-main">';
    echo '<div class="container">';

    // Hero
    echo '<section class="hero" style="margin-top:24px;">';
    echo '<div class="hero-bar"></div>';
    echo '<div class="hero-inner" style="padding:32px 28px 28px;">';
    echo '<div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;">';
    echo '<img src="/assets/images/logos/mk-logo.png" alt="Mkomigbo" width="56" height="56" style="border-radius:16px;border:1px solid var(--border);">';
    echo '<div><h1 style="margin:0;font-size:clamp(1.6rem,3.5vw,2.6rem);line-height:1.06;letter-spacing:-0.02em;">Mkomigbo</h1>';
    echo '<p style="margin:4px 0 0;color:var(--muted);font-size:1.05rem;">Igbo Knowledge Platform</p></div>';
    echo '</div>';
    echo '<p style="margin:0;max-width:70ch;line-height:1.75;font-size:1.06rem;">A comprehensive resource for Igbo history, culture, language, spirituality, and the broader African experience — built by scholars, for everyone.</p>';
    echo '<div class="cta-row">';
    echo '<a href="/subjects/" style="display:inline-flex;align-items:center;gap:8px;padding:11px 20px;background:var(--fg);color:#fff;border-radius:12px;text-decoration:none;font-weight:700;font-size:.95rem;">Explore Subjects →</a>';
    echo '<a href="/contributors/" style="display:inline-flex;align-items:center;gap:8px;padding:11px 20px;background:transparent;color:var(--fg);border:1px solid var(--border);border-radius:12px;text-decoration:none;font-weight:700;font-size:.95rem;">Meet Contributors</a>';
    echo '<a href="/awag/" style="padding:11px 20px;background:transparent;color:var(--fg);border:1px solid var(--border);border-radius:12px;text-decoration:none;font-weight:700;font-size:.95rem;">🌍 AWAG</a>';
  echo '<a href="/igbo-calendar/" style="display:inline-flex;align-items:center;gap:8px;padding:11px 20px;background:transparent;color:var(--fg);border:1px solid var(--border);border-radius:12px;text-decoration:none;font-weight:700;font-size:.95rem;">📅 Igbo Calendar</a>';
    echo '</div>';
    echo '</div>';
    echo '</section>';

    // Quick links grid
    echo '<div class="section-title" style="margin-top:32px;">';
    echo '<h2 style="margin:0;font-size:1.15rem;font-weight:900;">Explore the Platform</h2>';
    echo '<a href="/subjects/" style="font-size:.9rem;color:var(--muted);text-decoration:none;">All subjects →</a>';
    echo '</div>';

    echo '<div class="quick">';
    foreach ($sections as $s) {
        echo '<a href="' . htmlspecialchars($s['href'], ENT_QUOTES) . '" class="quick-card" style="display:flex;gap:14px;align-items:flex-start;padding:16px;border:1px solid var(--border);border-radius:16px;background:var(--card);text-decoration:none;color:inherit;box-shadow:0 4px 16px rgba(0,0,0,.05);transition:transform .12s,box-shadow .12s,border-color .12s;" onmouseover="this.style.transform=\'translateY(-2px)\';this.style.boxShadow=\'0 10px 28px rgba(0,0,0,.10)\';this.style.borderColor=\'rgba(0,0,0,.20)\'" onmouseout="this.style.transform=\'\';this.style.boxShadow=\'0 4px 16px rgba(0,0,0,.05)\';this.style.borderColor=\'var(--border)\'">';
        echo '<div class="q-icon" style="width:46px;height:46px;border-radius:14px;border:1px solid var(--border);background:rgba(0,0,0,.02);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex:0 0 auto;">' . $s['icon'] . '</div>';
        echo '<div><p class="q-title" style="margin:0;font-weight:800;font-size:1rem;">' . htmlspecialchars($s['title'], ENT_QUOTES) . '</p>';
        echo '<p class="q-desc muted" style="margin:4px 0 0;font-size:.88rem;line-height:1.55;color:var(--muted);">' . htmlspecialchars($s['desc'], ENT_QUOTES) . '</p></div>';
        echo '</a>';
    }
    echo '</div>';

    // About strip
    echo '<section style="margin-top:36px;padding:24px;border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:0 4px 16px rgba(0,0,0,.04);">';
    echo '<h2 style="margin:0 0 10px;font-size:1.1rem;font-weight:900;">About Mkomigbo</h2>';
    echo '<p style="margin:0;max-width:80ch;line-height:1.75;color:var(--fg);">Mkomigbo is an open knowledge project dedicated to preserving and sharing Igbo heritage. From ancient history and oral tradition to contemporary diaspora experience, every subject is researched, sourced, and made freely accessible.</p>';
    echo '<div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">';
    echo '<a href="/subjects/about" style="padding:8px 14px;border:1px solid var(--border);border-radius:10px;text-decoration:none;color:var(--fg);font-weight:600;font-size:.9rem;background:#fff;">About the Project</a>';
    echo '<a href="/contributors/" style="padding:8px 14px;border:1px solid var(--border);border-radius:10px;text-decoration:none;color:var(--fg);font-weight:600;font-size:.9rem;background:#fff;">Contribute</a>';
    
    echo '</div>';
    echo '</section>';

    echo '</div>'; // .container
    echo '</main>';

    // Footer
    echo '<footer style="margin-top:48px;padding:28px 0;border-top:1px solid var(--border);">';
    echo '<div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">';
    echo '<span style="color:var(--muted);font-size:.9rem;">© ' . date('Y') . ' Mkomigbo · Igbo Knowledge Platform</span>';
    echo '<nav style="display:flex;gap:16px;">';
    echo '<a href="/subjects/" style="color:var(--muted);text-decoration:none;font-size:.9rem;">Subjects</a>';
    echo '<a href="/platforms/" style="color:var(--muted);text-decoration:none;font-size:.9rem;">Platforms</a>';
    echo '<a href="/contributors/" style="color:var(--muted);text-decoration:none;font-size:.9rem;">Contributors</a>';
    echo '<a href="/awag/" style="padding:11px 20px;background:transparent;color:var(--fg);border:1px solid var(--border);border-radius:12px;text-decoration:none;font-weight:700;font-size:.95rem;">🌍 AWAG</a>';
  echo '<a href="/igbo-calendar/" style="color:var(--muted);text-decoration:none;font-size:.9rem;">Calendar</a>';
    
    echo '</nav>';
    echo '</div>';
    echo '</footer>';

    echo '</body></html>';
}
