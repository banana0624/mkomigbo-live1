# =========================================================
# /home/mkomigbo/public_html/.htaccess
# Canonical Clean URLs + Performance Hardening (SAFE)
# - Static assets: long cache (immutable)
# - Dynamic (PHP/HTML): do NOT force cache here (PHP decides)
# - LiteSpeed/Apache friendly
# =========================================================

RewriteEngine On

# If the request is for an existing file/dir in current docroot, serve it normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, route into /public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]


Options -Indexes -MultiViews
DirectoryIndex index.php

# ---------------------------------------------------------
# SECURITY: deny dotfiles + secrets + backup artifacts
# ---------------------------------------------------------

# Block access to hidden files/folders (.env, .git, .ht*, etc.)
<IfModule mod_rewrite.c>
RewriteEngine On

# Block dotfiles (except ".well-known" for ACME/verification)
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

# Block common secret/config filenames anywhere
RewriteRule "(^|/)(?:\.env|env\.php|config\.php|composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock)$" - [F,L,NC]

# Block common backup/swap/dump artifacts
RewriteRule "\.(?:bak|old|orig|save|swp|swo|tmp|temp|dist|sql|gz|zip)$" - [F,L,NC]
RewriteRule "(?:~|\.(?:bak|old|orig|save))$" - [F,L,NC]
</IfModule>

# Disable ETags (avoids proxy/cache mismatch)
FileETag None

<IfModule mod_headers.c>
  Header unset ETag

  # Cache-bustable static assets (CSS/JS/images/fonts/json)
  <FilesMatch "\.(?:css|js|mjs|map|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|otf|eot|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Vary "Accept-Encoding"
  </FilesMatch>

  # Security baseline (safe defaults)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Optional (enable only if your entire site is always HTTPS)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # CSS/JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 7 days"

  # Images
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# Compression (safe)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Brotli (if available)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------
# SECURITY: HTTP method tightening (safe)
# ---------------------------------------------------------
<IfModule mod_rewrite.c>
  # Block TRACE/TRACK explicitly
  RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK)$ [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# ---------------------------------------------------------
# REWRITE: Canonical clean URLs + module routing
# ---------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# 0) STATIC BYPASS (CRITICAL): serve real files/dirs directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Defense-in-depth: block public staff tools path (even if directory exists)
RewriteRule ^staff/?(.*)$          public/staff/$1          [L,NC,QSA]


# Optional: avoid /index.php duplicates
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Diagnostic endpoint (optional)
RewriteRule ^rewrite-test$ rewrite-test.php [L]

# 1) Home
RewriteRule ^$ public/index.php [L,QSA]

# ---------------------------------------------------------
# 2) Subjects (Canonical clean URLs)
# Canonical:
#   /subjects/                  -> index
#   /subjects/{subject}/        -> subject controller
#   /subjects/{subject}/{page}/ -> page controller
# ---------------------------------------------------------

# Index
RewriteRule ^subjects/?$ public/subjects/index.php [L,QSA]

# Redirect direct controller access to canonical
RewriteCond %{THE_REQUEST} \s/+subjects/subject\.php\?slug=([a-z0-9][a-z0-9_-]{0,190}) [NC]
RewriteRule ^subjects/subject\.php$ /subjects/%1/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+subjects/page\.php\?subject=([a-z0-9][a-z0-9_-]{0,190})\&slug=([a-z0-9][a-z0-9_-]{0,190}) [NC]
RewriteRule ^subjects/page\.php$ /subjects/%1/%2/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+subjects/page\.php\?subject=([a-z0-9][a-z0-9_-]{0,190})\&page=([a-z0-9][a-z0-9_-]{0,190}) [NC]
RewriteRule ^subjects/page\.php$ /subjects/%1/%2/ [R=301,L]

# Canonical routing
RewriteRule ^subjects/([a-z0-9][a-z0-9_-]{0,190})/([a-z0-9][a-z0-9_-]{0,190})/?$ public/subjects/page.php?subject=$1&slug=$2 [L,QSA]
RewriteRule ^subjects/([a-z0-9][a-z0-9_-]{0,190})/?$ public/subjects/subject.php?slug=$1 [L,QSA]

# Allow any real file under /public/subjects/
RewriteRule ^subjects/(.*)$ public/subjects/$1 [L,NC,QSA]

# ---------------------------------------------------------
# 3) Contributors (Canonical clean URLs)
# Canonical:
#   /contributors/               -> index
#   /contributors/{slug}/        -> view by slug
#   /contributors/id/{id}/       -> view by numeric id
# Redirect controller URLs to canonical (DROP query strings).
# ---------------------------------------------------------

# Index
RewriteRule ^contributors/?$ public/contributors/index.php [L,QSA]

# Redirect direct controller access to canonical (no query string leak)
RewriteCond %{THE_REQUEST} \s/+contributors/view\.php\?slug=([a-z0-9][a-z0-9_-]{0,190}) [NC]
RewriteRule ^contributors/view\.php$ /contributors/%1/? [R=301,L]

RewriteCond %{THE_REQUEST} \s/+contributors/view\.php\?id=([0-9]{1,20}) [NC]
RewriteRule ^contributors/view\.php$ /contributors/id/%1/? [R=301,L]

# Canonical routing
RewriteRule ^contributors/id/([0-9]{1,20})/?$ public/contributors/view.php?id=$1 [L,QSA]
RewriteRule ^contributors/([a-z0-9][a-z0-9_-]{0,190})/?$ public/contributors/view.php?slug=$1 [L,QSA]

# Allow any real file under /public/contributors/
RewriteRule ^contributors/(.*)$ public/contributors/$1 [L,NC,QSA]

# ---------------------------------------------------------
# 4) Other modules (route into /public/<module>/...).
# Keep these AFTER Subjects/Contributors so they can't steal those URLs.
# ---------------------------------------------------------
RewriteRule ^platforms/?(.*)$      public/platforms/$1      [L,NC,QSA]
RewriteRule ^staff/?(.*)$          public/staff/$1          [L,NC,QSA]
RewriteRule ^igbo-calendar/?(.*)$  public/igbo-calendar/$1  [L,NC,QSA]

# ---------------------------------------------------------
# 5) Final fallback
# ---------------------------------------------------------
RewriteRule ^ public/index.php [L,QSA]

</IfModule>

ErrorDocument 404 /404.shtml
